+import Darwin
+import Foundation
+import Testing
+@testable import OmarchyVMHelper
+
+@Suite("Managed factory download cache")
+struct ManagedFactoryCacheTests {
+    private func fixture() throws -> URL {
+        let root = FileManager.default.temporaryDirectory.appendingPathComponent("managed-factory-\(UUID())")
+        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+        return root
+    }
+
+    private func managedRoot(in container: URL) throws -> URL {
+        let root = container.appendingPathComponent(UUID().uuidString)
+        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+        let data = try JSONSerialization.data(withJSONObject: ["schemaVersion": 1, "id": root.lastPathComponent])
+        try data.write(to: root.appendingPathComponent(".omarchy-vm-manager.json"))
+        try FileManager.default.setAttributes([.posixPermissions: 0o600], ofItemAtPath: root.appendingPathComponent(".omarchy-vm-manager.json").path)
+        return root
+    }
+
+    @Test("distinct managed guests share one Downloads cache; other roots do not opt in")
+    func selection() throws {
+        let container = try fixture(); defer { try? FileManager.default.removeItem(at: container) }
+        let a = try managedRoot(in: container), b = try managedRoot(in: container)
+        let downloads = container.appendingPathComponent("Downloads")
+        let expected = downloads.appendingPathComponent("Omarchy VM Manager/Factory Images", isDirectory: true)
+        #expect(try ManagedFactoryCache.directory(for: a, downloads: downloads) == expected)
+        #expect(try ManagedFactoryCache.directory(for: b, downloads: downloads) == expected)
+        #expect(try ManagedFactoryCache.directory(for: container, downloads: downloads) == nil)
+        #expect(!FileManager.default.fileExists(atPath: downloads.path))
+    }
+
+    @Test("damaged, mismatched and linked manager markers fail closed", arguments: ["invalid", "mismatch", "symlink", "permissions"])
+    func invalidMarker(kind: String) throws {
+        let container = try fixture(); defer { try? FileManager.default.removeItem(at: container) }
+        let root = try managedRoot(in: container)
+        let marker = root.appendingPathComponent(".omarchy-vm-manager.json")
+        switch kind {
+        case "invalid": try Data("invalid".utf8).write(to: marker)
+        case "mismatch": try JSONSerialization.data(withJSONObject: ["schemaVersion": 1, "id": UUID().uuidString]).write(to: marker)
+        case "symlink":
+            let target = container.appendingPathComponent("marker")
+            try FileManager.default.moveItem(at: marker, to: target)
+            try FileManager.default.createSymbolicLink(at: marker, withDestinationURL: target)
+        default: try FileManager.default.setAttributes([.posixPermissions: 0o644], ofItemAtPath: marker.path)
+        }
+        #expect(throws: (any Error).self) { try ManagedFactoryCache.directory(for: root, downloads: container.appendingPathComponent("Downloads")) }
+    }
+
+    @Test("cache preparation makes only private cache folders and never a VM workspace")
+    func preparation() throws {
+        let container = try fixture(); defer { try? FileManager.default.removeItem(at: container) }
+        let downloads = container.appendingPathComponent("Downloads")
+        try ManagedFactoryCache.prepare(downloads: downloads)
+        try ManagedFactoryCache.prepare(downloads: downloads)
+        let cache = ManagedFactoryCache.cacheDirectory(downloads: downloads)
+        try ManagedSSHLaunch.directory(cache)
+        #expect(try FileManager.default.contentsOfDirectory(atPath: cache.path).isEmpty)
+        #expect(!StorageLocationPolicy.hasValidRootMarker(in: cache.deletingLastPathComponent()))
+    }
+
+    @Test("cache preparation preserves symbolic links and existing unsafe directories", arguments: ["downloads-link", "cache-link", "permissions"])
+    func unsafeDirectory(kind: String) throws {
+        let container = try fixture(); defer { try? FileManager.default.removeItem(at: container) }
+        let downloads = container.appendingPathComponent("Downloads")
+        let target = container.appendingPathComponent("untouched")
+        try FileManager.default.createDirectory(at: target, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+        if kind == "downloads-link" {
+            try FileManager.default.createSymbolicLink(at: downloads, withDestinationURL: target)
+        } else {
+            try ManagedFactoryCache.prepare(downloads: downloads)
+            let cache = ManagedFactoryCache.cacheDirectory(downloads: downloads)
+            if kind == "cache-link" {
+                try FileManager.default.removeItem(at: cache)
+                try FileManager.default.createSymbolicLink(at: cache, withDestinationURL: target)
+            } else { try FileManager.default.setAttributes([.posixPermissions: 0o755], ofItemAtPath: cache.path) }
+        }
+        #expect(throws: (any Error).self) { try ManagedFactoryCache.prepare(downloads: downloads) }
+        #expect(try FileManager.default.contentsOfDirectory(atPath: target.path).isEmpty)
+    }
+
+    @Test("new disks always pass shared compressed images through the verifier; existing disks need no download")
+    func planning() throws {
+        let container = try fixture(); defer { try? FileManager.default.removeItem(at: container) }
+        let a = try managedRoot(in: container), b = try managedRoot(in: container)
+        let downloads = container.appendingPathComponent("Downloads")
+        try ManagedFactoryCache.prepare(downloads: downloads)
+        let cache = ManagedFactoryCache.cacheDirectory(downloads: downloads)
+        let identity = String(repeating: "a", count: 64)
+        let manifest = try #require(FactoryDownloadManifest.decode(JSONSerialization.data(withJSONObject: [
+            "format": 1, "kind": "try-omarchy-factory-download", "identity": identity,
+            "image": ["bytes": 4, "sha256": identity], "parts": [["url": "https://example.com/part", "bytes": 4, "sha256": identity]]
+        ])))
+        try Data("zstd".utf8).write(to: FactoryImageStore.imageURL(in: cache, identity: identity))
+        for root in [a, b] {
+            #expect(FactoryImagePreparation.plan(manifest: manifest, bundlesImage: false, stateRoot: root, sharedFactory: nil, downloadCache: cache) == .download(directory: cache))
+        }
+        try FileManager.default.createDirectory(at: a.appendingPathComponent("shell"), withIntermediateDirectories: false)
+        try Data().write(to: a.appendingPathComponent("shell/disk.img"))
+        #expect(FactoryImagePreparation.plan(manifest: manifest, bundlesImage: false, stateRoot: a, sharedFactory: nil, downloadCache: cache) == .ready(image: FactoryImageStore.imageURL(in: cache, identity: identity)))
+    }
+
+    @Test("only obsolete owned images unused for seven days are pruned under the download lock")
+    func retention() throws {
+        let container = try fixture(); defer { try? FileManager.default.removeItem(at: container) }
+        let current = String(repeating: "a", count: 64), old = String(repeating: "b", count: 64)
+        let recent = String(repeating: "c", count: 64), linked = String(repeating: "d", count: 64)
+        let now = Date()
+        for name in ["\(current).img.zst", "\(current).img", "\(old).img.zst", "\(old).img.zst.download", "\(recent).img.zst", "notes.img.zst"] {
+            let file = container.appendingPathComponent(name)
+            try Data().write(to: file)
+            try FileManager.default.setAttributes([.posixPermissions: 0o600, .modificationDate: now.addingTimeInterval(name.hasPrefix(recent) ? -86400 : -8 * 86400)], ofItemAtPath: file.path)
+        }
+        try FileManager.default.createSymbolicLink(at: container.appendingPathComponent("\(linked).img.zst"), withDestinationURL: container.appendingPathComponent("notes.img.zst"))
+        let lock = open(container.path, O_RDONLY | O_DIRECTORY)
+        #expect(lock >= 0)
+        defer { close(lock) }
+        #expect(flock(lock, LOCK_EX) == 0)
+        FactoryImageStore.removeObsoleteDownloads(in: container, identity: current, retention: ManagedFactoryCache.retention, now: now)
+        #expect(FileManager.default.fileExists(atPath: container.appendingPathComponent("\(old).img.zst").path))
+        #expect(flock(lock, LOCK_UN) == 0)
+        FactoryImageStore.removeObsoleteDownloads(in: container, identity: current, retention: ManagedFactoryCache.retention, now: now)
+        #expect(Set(try FileManager.default.contentsOfDirectory(atPath: container.path)) == ["\(current).img.zst", "\(current).img", "\(recent).img.zst", "\(linked).img.zst", "notes.img.zst"])
+    }
+
+    @Test("cache validation refuses symbolic links and hard links without modifying their targets", arguments: [false, true])
+    func unsafeImage(hardLink: Bool) throws {
+        let container = try fixture(); defer { try? FileManager.default.removeItem(at: container) }
+        let identity = String(repeating: "a", count: 64)
+        let target = container.appendingPathComponent("keep")
+        try Data("preserved".utf8).write(to: target)
+        try FileManager.default.setAttributes([.posixPermissions: 0o600], ofItemAtPath: target.path)
+        let image = FactoryImageStore.partialURL(in: container, identity: identity)
+        if hardLink { try FileManager.default.linkItem(at: target, to: image) }
