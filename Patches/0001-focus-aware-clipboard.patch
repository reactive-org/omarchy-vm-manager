@@ -0,0 +1,113 @@
+import CryptoKit
+import Darwin
+import Foundation
+
+public struct VMFactorySelection: Codable, Equatable, Sendable {
+    public static let capabilityVersion = 1
+    public static let packagePath = "Contents/Resources/guest-packages/try-omarchy-0.1.0-40-aarch64.pkg.tar.zst"
+    public let bundlePath: String
+    public let manifestSHA256: String
+    public init(bundlePath: String, manifestSHA256: String) {
+        self.bundlePath = bundlePath; self.manifestSHA256 = manifestSHA256
+    }
+    public func validate() throws {
+        guard bundlePath.hasPrefix("/"), bundlePath.utf8.count <= 1024,
+              !bundlePath.unicodeScalars.contains(where: { CharacterSet.controlCharacters.contains($0) }),
+              Self.isDigest(manifestSHA256) else { throw VMRunProtocolError.invalidConfiguration }
+    }
+    public static func isDigest(_ value: String) -> Bool {
+        value.count == 64 && value.allSatisfy { ("0"..."9").contains($0) || ("a"..."f").contains($0) }
+    }
+    public static func digest(_ url: URL) throws -> String {
+        let fd = open(url.path, O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC)
+        guard fd >= 0 else { throw VMRunProtocolError.invalidConfiguration }
+        defer { close(fd) }
+        var info = stat()
+        guard fstat(fd, &info) == 0, info.st_mode & S_IFMT == S_IFREG else { throw VMRunProtocolError.invalidConfiguration }
+        let file = FileHandle(fileDescriptor: fd, closeOnDealloc: false)
+        var hash = SHA256()
+        while let data = try file.read(upToCount: 1_048_576), !data.isEmpty { hash.update(data: data) }
+        return hash.finalize().map { String(format: "%02x", $0) }.joined()
+    }
+    public static func readMetadata(_ url: URL) throws -> Data {
+        let fd = open(url.path, O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC)
+        guard fd >= 0 else { throw VMRunProtocolError.invalidConfiguration }
+        defer { close(fd) }
+        var info = stat()
+        guard fstat(fd, &info) == 0, info.st_mode & S_IFMT == S_IFREG, info.st_size > 0, info.st_size <= 65536 else { throw VMRunProtocolError.invalidConfiguration }
+        let data = try FileHandle(fileDescriptor: fd, closeOnDealloc: false).read(upToCount: 65537) ?? Data()
+        guard data.count <= 65536 else { throw VMRunProtocolError.invalidConfiguration }
+        return data
+    }
+    private static func dataDigest(_ data: Data) -> String {
+        SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined()
+    }
+    public func verified(runtimeBundle: URL) throws -> VMFactoryManifest {
+        try validate()
+        let root = URL(fileURLWithPath: bundlePath)
+        var info = stat()
+        guard root.standardizedFileURL.path == root.resolvingSymlinksInPath().path,
+              lstat(root.path, &info) == 0, info.st_mode & S_IFMT == S_IFDIR else { throw VMRunProtocolError.invalidConfiguration }
+        let manifestURL = root.appendingPathComponent("reviewed-factory.json")
+        let manifestData = try Self.readMetadata(manifestURL)
+        guard Self.dataDigest(manifestData) == manifestSHA256 else { throw VMRunProtocolError.invalidConfiguration }
+        let manifest = try JSONDecoder().decode(VMFactoryManifest.self, from: manifestData)
+        try manifest.validate()
+        guard Set(try FileManager.default.contentsOfDirectory(atPath: root.path)) == Set(manifest.files.keys).union(["reviewed-factory.json"]) else { throw VMRunProtocolError.invalidConfiguration }
+        for (name, hash) in manifest.files {
+            guard try Self.digest(root.appendingPathComponent(name)) == hash else { throw VMRunProtocolError.invalidConfiguration }
+        }
+        for (name, hash) in manifest.runtimeFiles {
+            let file = runtimeBundle.appendingPathComponent(name)
+            guard file.standardizedFileURL.path == file.resolvingSymlinksInPath().path,
+                  try Self.digest(file) == hash else { throw VMRunProtocolError.invalidConfiguration }
+        }
+        let factoryData = try Self.readMetadata(root.appendingPathComponent("factory.json"))
+        guard Self.dataDigest(factoryData) == manifest.files["factory.json"] else { throw VMRunProtocolError.invalidConfiguration }
+        let factory = try JSONDecoder().decode(VMFactoryManifest.Image.self, from: factoryData)
+        guard factory.format == 1, factory.kind == "upstream-shell-factory", factory.platform == "aarch64", factory.boot == "uefi-limine",
+              factory.disk.bytes > 0, factory.disk.bytes <= 8192 * 1_073_741_824,
+              Self.isDigest(factory.disk.sha256), Self.isDigest(factory.compressed.sha256),
+              factory.compressed.path.hasSuffix(".img.zst"), manifest.files[factory.compressed.path] == factory.compressed.sha256,
+              VMFactoryManifest.safeName(factory.disk.path), factory.disk.path.hasSuffix(".img") else { throw VMRunProtocolError.invalidConfiguration }
+        return manifest
+    }
+}
+
+public struct VMFactoryManifest: Codable, Equatable, Sendable {
+    public let format: Int
+    public let name: String
+    public let architecture: String
+    public let boot: String
+    public let customFactoryVersion: Int
+    public let managedSSHVersion: Int
+    public let managedSetupVersion: Int
+    public let integrationPackageSHA256: String
+    public let ownerSetupContractSHA256: String
+    public let files: [String: String]
+    public let provisioning: [String: String]
+    public let runtimeFiles: [String: String]
+    public struct Image: Decodable {
+        public struct Disk: Decodable { public let path: String; public let sha256: String; public let bytes: Int64 }
+        public struct Compressed: Decodable { public let path: String; public let sha256: String }
+        public let format: Int; public let kind: String; public let platform: String; public let boot: String
+        public let disk: Disk; public let compressed: Compressed
+    }
+    public static func safeName(_ name: String) -> Bool {
+        !name.isEmpty && name != "." && name != ".." && name.utf8.count <= 255 && name.allSatisfy { $0.isASCII && ($0.isLetter || $0.isNumber || "._-".contains($0)) }
+    }
+    public func validate() throws {
+        let required: Set<String> = ["Contents/MacOS/omarchy-vm-helper", "Contents/Resources/runtime/bin/Try Omarchy", "Contents/Resources/firmware/edk2-aarch64-code.fd", "Contents/Resources/scripts/run-qemu-gpu.sh", VMFactorySelection.packagePath]
+        guard format == 1, architecture == "aarch64", boot == "uefi-limine", customFactoryVersion == 1,
+              managedSSHVersion == 1, managedSetupVersion == 1,
+              !name.isEmpty, name.utf8.count <= 128, !name.unicodeScalars.contains(where: { CharacterSet.controlCharacters.contains($0) }),
+              (2...32).contains(files.count), files["factory.json"] != nil, files["reviewed-factory.json"] == nil,
+              files.keys.allSatisfy(Self.safeName), files.values.allSatisfy(VMFactorySelection.isDigest),
+              !provisioning.isEmpty, provisioning.allSatisfy({ files[$0.key] == $0.value }),
+              required.isSubset(of: Set(runtimeFiles.keys)), runtimeFiles.count <= 256,
+              runtimeFiles.keys.allSatisfy({ $0.hasPrefix("Contents/") && $0.split(separator: "/", omittingEmptySubsequences: false).allSatisfy { !$0.isEmpty && $0 != "." && $0 != ".." } }),
+              runtimeFiles.values.allSatisfy(VMFactorySelection.isDigest),
+              VMFactorySelection.isDigest(ownerSetupContractSHA256),
+              runtimeFiles[VMFactorySelection.packagePath] == integrationPackageSHA256 else { throw VMRunProtocolError.invalidConfiguration }
+    }
+}
