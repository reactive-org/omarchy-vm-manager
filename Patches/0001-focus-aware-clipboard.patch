diff --git a/guest/package/try-omarchy/files/usr/lib/try-omarchy/managed-ssh b/guest/package/try-omarchy/files/usr/lib/try-omarchy/managed-ssh
new file mode 100755
index 0000000..7c299d1
--- /dev/null
+++ b/guest/package/try-omarchy/files/usr/lib/try-omarchy/managed-ssh
@@ -0,0 +1,165 @@
+#!/usr/bin/python3 -I
+"""Enroll managed SSH through a per-VM read-only host provisioning share."""
+import json
+import os
+from pathlib import Path
+import pwd
+import re
+import stat
+import subprocess
+import tempfile
+import uuid
+
+BASE = Path(os.environ.get("TRY_OMARCHY_MANAGED_STATE", "/var/lib/try-omarchy/managed-ssh"))
+RUN = Path(os.environ.get("TRY_OMARCHY_MANAGED_RUN", "/run/try-omarchy/managed-ssh"))
+SHARE = Path(os.environ.get("TRY_OMARCHY_MANAGED_SHARE", "/run/try-omarchy/managed-ssh-share"))
+CMDLINE = Path(os.environ.get("TRY_OMARCHY_HOST_CMDLINE", "/run/try-omarchy/cmdline"))
+PENDING = Path(os.environ.get("TRY_OMARCHY_OWNER_PENDING", "/var/lib/omarchy/provisioning/pending"))
+SYSTEMCTL = os.environ.get("TRY_OMARCHY_SYSTEMCTL", "/usr/bin/systemctl")
+ROOT = Path(os.environ.get("TRY_OMARCHY_SYSTEM_ROOT", "/"))
+
+
+def private_directory(path, mode=0o700):
+    path.mkdir(mode=mode, parents=True, exist_ok=True)
+    s = path.lstat()
+    if not stat.S_ISDIR(s.st_mode) or s.st_uid != os.geteuid() or s.st_mode & 0o022:
+        raise ValueError("unsafe directory")
+
+
+def read(path, limit=16384):
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    try:
+        s = os.fstat(fd)
+        if not stat.S_ISREG(s.st_mode) or s.st_nlink != 1 or s.st_size > limit:
+            raise ValueError("unsafe provisioning file")
+        with os.fdopen(fd, "rb", closefd=False) as stream:
+            data = stream.read(limit + 1)
+        if len(data) > limit:
+            raise ValueError("oversized provisioning file")
+        return data
+    finally:
+        os.close(fd)
+
+
+def write(path, data, mode=0o600):
+    if path.exists() and read(path) == data:
+        return
+    fd, temporary = tempfile.mkstemp(prefix=".managed-ssh-", dir=path.parent)
+    try:
+        os.fchmod(fd, mode)
+        with os.fdopen(fd, "wb", closefd=False) as stream:
+            stream.write(data)
+            stream.flush()
+            os.fsync(fd)
+        os.replace(temporary, path)
+    finally:
+        os.close(fd)
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+
+
+def public_key(value):
+    import base64
+    if not isinstance(value, str) or len(value) > 16384 or "\n" in value or "\r" in value:
+        raise ValueError("invalid public key")
+    fields = value.split()
+    if len(fields) < 2 or fields[0] not in ("ssh-ed25519", "ssh-rsa", "ecdsa-sha2-nistp256", "ecdsa-sha2-nistp384", "ecdsa-sha2-nistp521", "sk-ssh-ed25519@openssh.com", "sk-ecdsa-sha2-nistp256@openssh.com"):
+        raise ValueError("unsupported public key")
+    blob = base64.b64decode(fields[1], validate=True)
+    if len(blob) < 16 or int.from_bytes(blob[:4], "big") != len(fields[0]) or blob[4:4 + len(fields[0])].decode() != fields[0]:
+        raise ValueError("invalid public key")
+    return " ".join(fields[:2])
+
+
+def status(manifest, state, owner=None):
+    value = {"schemaVersion": 1, "vmID": manifest["vmID"], "sessionToken": manifest["sessionToken"], "state": state}
+    if owner:
+        value["owner"] = owner
+    write(RUN / "status.json", (json.dumps(value, separators=(",", ":")) + "\n").encode(), 0o644)
+
+
+def owner_account(binding):
+    candidates = [p for p in pwd.getpwall() if 1000 <= p.pw_uid < 60000 and re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", p.pw_name) and p.pw_shell not in ("/bin/false", "/usr/bin/false", "/usr/sbin/nologin", "/usr/bin/nologin")]
+    if binding.get("owner"):
+        candidates = [p for p in candidates if p.pw_name == binding["owner"]]
+    return candidates[0] if len(candidates) == 1 else None
+
+
+def main():
+    if "tryomarchy.managed_ssh=1" not in CMDLINE.read_text().split():
+        return
+    private_directory(RUN, 0o755)
+    if "TRY_OMARCHY_MANAGED_SHARE" not in os.environ:
+        private_directory(SHARE)
+        if not os.path.ismount(SHARE):
+            subprocess.run(["/usr/bin/mount", "-t", "9p", "-o", "trans=virtio,version=9p2000.L,ro,access=any", "tryomarchy-managed-ssh", str(SHARE)], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
+    manifest = json.loads(read(SHARE / "manifest.json"))
+    if set(manifest) != {"schemaVersion", "vmID", "sessionToken", "publicKeys"} or type(manifest["schemaVersion"]) is not int or manifest["schemaVersion"] != 1:
+        raise ValueError("unknown provisioning schema")
+    uuid.UUID(manifest["vmID"]); uuid.UUID(manifest["sessionToken"])
+    if not isinstance(manifest["publicKeys"], list) or not 1 <= len(manifest["publicKeys"]) <= 2:
+        raise ValueError("invalid authorized key list")
+    keys = [public_key(k) for k in manifest["publicKeys"]]
+    private_directory(BASE, 0o755)
+    identity_path = BASE / "identity.json"
+    binding = json.loads(read(identity_path)) if identity_path.exists() else {"vmID": manifest["vmID"]}
+    if binding.get("vmID") != manifest["vmID"]:
+        raise ValueError("VM identity changed")
+    host_key = BASE / "host_ed25519"
+    offered = read(SHARE / "host_ed25519", 8192)
+    expected = public_key(read(SHARE / "host_ed25519.pub").decode().strip())
+    if host_key.exists():
+        result = subprocess.run(["/usr/bin/ssh-keygen", "-y", "-P", "", "-f", str(host_key)], check=True, capture_output=True, timeout=5)
+        if result.stdout.decode().strip().split()[:2] != expected.split():
+            raise ValueError("SSH host identity changed")
+    else:
+        write(host_key, offered)
+        result = subprocess.run(["/usr/bin/ssh-keygen", "-y", "-P", "", "-f", str(host_key)], check=True, capture_output=True, timeout=5)
+        if result.stdout.decode().strip().split()[:2] != expected.split():
+            raise ValueError("SSH host identity mismatch")
+    write(identity_path, (json.dumps(binding) + "\n").encode())
+    owner = None if PENDING.exists() else owner_account(binding)
+    if owner is None:
+        status(manifest, "waiting-owner")
+        return
+    binding["owner"] = owner.pw_name
+    write(identity_path, (json.dumps(binding) + "\n").encode())
+    authorized = BASE / "authorized"
+    private_directory(authorized, 0o755)
+    write(authorized / owner.pw_name, ("\n".join(keys) + "\n").encode(), 0o644)
+    config = f"""Port 22
+HostKey {host_key}
+AuthorizedKeysFile .ssh/authorized_keys {authorized}/%u
+PubkeyAuthentication yes
+PasswordAuthentication no
+KbdInteractiveAuthentication no
+PermitRootLogin no
+UsePAM yes
+AllowUsers {owner.pw_name}
+Subsystem sftp internal-sftp
+"""
+    write(RUN / "sshd_config", config.encode())
+    override = ROOT / "run/systemd/system/sshd.service.d"
+    private_directory(override, 0o755)
+    unit = f"[Service]\nExecStart=\nExecStart=/usr/bin/sshd -D -f {RUN}/sshd_config\n"
+    previous = read(override / "90-try-omarchy-managed.conf") if (override / "90-try-omarchy-managed.conf").exists() else b""
+    write(override / "90-try-omarchy-managed.conf", unit.encode(), 0o644)
+    subprocess.run(["/usr/bin/sshd", "-t", "-f", str(RUN / "sshd_config")], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
+    if previous != unit.encode():
