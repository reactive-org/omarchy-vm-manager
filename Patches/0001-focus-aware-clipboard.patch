+@Suite("Clipboard headless main run loop")
+struct ClipboardMainRunLoopTests {
+    @Test("the actual headless runner services main-queue updates and returns reader results")
+    func standaloneMainRunLoop() throws {
+        let macos = URL(fileURLWithPath: #filePath).deletingLastPathComponent()
+            .deletingLastPathComponent().deletingLastPathComponent()
+        let source = try String(contentsOf: macos.appendingPathComponent("Sources/OmarchyVMHelper/NativeClipboardBridge.swift"), encoding: .utf8)
+        let start = try #require(source.range(of: "private final class ClipboardRunCompletion"))
+        let end = try #require(source.range(of: "protocol ClipboardFocusProviding"))
+        let runner = String(source[start.lowerBound..<end.lowerBound])
+        let focusEnd = try #require(source.range(of: "final class FocusedClipboardRouting"))
+        let focusAdapter = String(source[end.lowerBound..<focusEnd.lowerBound])
+        let temporary = FileManager.default.temporaryDirectory.appendingPathComponent("clipboard-runloop-" + UUID().uuidString)
+        try FileManager.default.createDirectory(at: temporary, withIntermediateDirectories: false)
+        defer { try? FileManager.default.removeItem(at: temporary) }
+        let program = temporary.appendingPathComponent("probe.swift")
+        let executable = temporary.appendingPathComponent("probe")
+        let code = """
+        import AppKit
+        import CoreFoundation
+        import Foundation
+        enum HelperError: Error { case io(String) }
+        struct KernelProcessIdentity {
+            let processIdentifier: pid_t
+            let isStillRunning: Bool
+        }
+        \(runner)
+        \(focusAdapter)
+        do {
+            switch CommandLine.arguments[1] {
+            case "focus":
+                var foreground: pid_t? = 42
+                let focus = QEMUClipboardFocus(
+                    processIdentity: KernelProcessIdentity(processIdentifier: 42, isStillRunning: true),
+                    frontmostProcessIdentifier: {
+                        guard Thread.isMainThread else { exit(4) }
+                        return foreground
+                    }
+                )
+                guard focus.isFocused() else { exit(5) }
+                let stale = QEMUClipboardFocus(
+                    processIdentity: KernelProcessIdentity(processIdentifier: 42, isStillRunning: false),
+                    frontmostProcessIdentifier: { exit(6) }
+                )
+                try ClipboardMainRunLoop.run {
+                    guard focus.isFocused(), !stale.isFocused() else { exit(7) }
+                    ClipboardMainRunLoop.readOnMain { foreground = 43 }
+                    guard !focus.isFocused() else { exit(8) }
+                    ClipboardMainRunLoop.readOnMain { foreground = nil }
+                    guard !focus.isFocused() else { exit(9) }
+                    ClipboardMainRunLoop.readOnMain { foreground = 42 }
+                    guard focus.isFocused() else { exit(10) }
+                }
+            case "mainqueue":
+                try ClipboardMainRunLoop.run { @Sendable in
+                    let delivered = DispatchSemaphore(value: 0)
+                    DispatchQueue.main.async { delivered.signal() }
+                    guard delivered.wait(timeout: .now() + 2) == .success else {
+                        throw HelperError.io("main-queue focus update was blocked")
+                    }
+                }
+            case "completed":
+                try ClipboardMainRunLoop.run { @Sendable in }
+            case "error":
+                var caught = false
+                do {
+                    try ClipboardMainRunLoop.run { @Sendable in throw HelperError.io("test channel closed") }
+                } catch HelperError.io { caught = true }
+                guard caught else { exit(2) }
+            default: exit(3)
+            }
+            exit(0)
+        } catch {
+            FileHandle.standardError.write(Data("\\(error)\\n".utf8))
+            exit(1)
+        }
+        """
+        try code.write(to: program, atomically: true, encoding: .utf8)
+        let compiler = Process()
+        compiler.executableURL = URL(fileURLWithPath: "/usr/bin/xcrun")
+        compiler.arguments = ["swiftc", "-swift-version", "5", "-module-cache-path", temporary.appendingPathComponent("modules").path,
+                              program.path, "-o", executable.path]
+        try compiler.run()
+        compiler.waitUntilExit()
+        try #require(compiler.terminationStatus == 0)
+        for mode in ["focus", "mainqueue", "completed", "error"] {
+            let child = Process()
+            child.executableURL = executable
+            child.arguments = [mode]
+            try child.run()
+            child.waitUntilExit()
+            #expect(child.terminationStatus == 0, "Headless run-loop mode: \(mode)")
+        }
+    }
+}
