+import Foundation
+import Testing
+@testable import OmarchyVMHelper
+
+@Suite("Stable guest application identity")
+struct GuestApplicationIdentityTests {
+    @Test("identity survives initial directory creation and symbolic path aliases")
+    func creation() throws {
+        let parent = URL(fileURLWithPath: "/private/tmp/guest-identity-" + UUID().uuidString)
+        try FileManager.default.createDirectory(at: parent, withIntermediateDirectories: false)
+        defer { try? FileManager.default.removeItem(at: parent) }
+        let root = parent.appendingPathComponent("guest")
+        let before = GuestApplicationIdentity.identifier(for: root)
+        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: false)
+        #expect(GuestApplicationIdentity.identifier(for: root) == before)
+        let alias = parent.appendingPathComponent("alias")
+        try FileManager.default.createSymbolicLink(at: alias, withDestinationURL: root)
+        #expect(GuestApplicationIdentity.identifier(for: alias) == before)
+    }
+
+    @Test("a root retains its identity and separate roots never share it")
+    func roots() {
+        let a = URL(fileURLWithPath: "/private/tmp/identity-test/A")
+        let b = URL(fileURLWithPath: "/private/tmp/identity-test/B")
+        let id = GuestApplicationIdentity.identifier(for: a)
+        #expect(id == GuestApplicationIdentity.identifier(for: a))
+        #expect(id != GuestApplicationIdentity.identifier(for: b))
+        #expect(id.hasPrefix("dev.tryomarchy.guest."))
+        #expect(!id.contains("/"))
+        #expect(id == GuestApplicationIdentity.identifier(for: a.appendingPathComponent("child/..")))
+    }
+}
