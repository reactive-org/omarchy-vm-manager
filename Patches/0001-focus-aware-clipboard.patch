@@ -0,0 +1,266 @@
+import copy
+import hashlib
+import importlib.machinery
+import importlib.util
+import json
+import os
+from pathlib import Path
+import stat
+import subprocess
+import tempfile
+import unittest
+from unittest.mock import patch
+import uuid
+
+ROOT = Path(__file__).resolve().parents[1]
+LIB = ROOT / 'try-omarchy/files/usr/lib/try-omarchy/managed-owner-setup'
+loader = importlib.machinery.SourceFileLoader('managed_setup', str(LIB))
+spec = importlib.util.spec_from_loader(loader.name, loader)
+m = importlib.util.module_from_spec(spec); loader.exec_module(m)
+CONTRACT = json.loads((ROOT / 'try-omarchy/files/usr/share/try-omarchy/owner-setup-contract.json').read_bytes())
+LEAN = json.loads((ROOT / 'try-omarchy/files/usr/share/try-omarchy/lean-owner-setup-contract.json').read_bytes())
+
+
+BOOT = '33333333-3333-4333-8333-333333333333'
+
+
+def command_line(manifest):
+    return 'tryomarchy.managed_setup=1 tryomarchy.managed_setup_report=' + m.binding_digest(m.report_binding(manifest))
+
+
+class ManagedSetupTests(unittest.TestCase):
+    def fixture(self, digest=None):
+        identity = str(uuid.uuid4()).upper()
+        value = {'schemaVersion': 1, 'vmID': identity, 'sessionToken': str(uuid.uuid4()).upper(), 'fingerprint': 'a' * 64,
+                 'hostname': 'work-' + identity[:8].lower(), 'configuration': {'username': 'owner', 'fullName': 'Synthetic Owner', 'email': 'owner@example.invalid', 'hostnamePrefix': 'work', 'timezone': 'UTC', 'keyboardID': 'English (US)'}}
+        if digest is not None: value['ownerSetupContractSHA256'] = digest
+        return value
+
