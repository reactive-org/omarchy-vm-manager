diff --git a/macos/Sources/OmarchyVMHelper/ManagedFactoryCache.swift b/macos/Sources/OmarchyVMHelper/ManagedFactoryCache.swift
new file mode 100644
index 0000000..d47aa37
--- /dev/null
+++ b/macos/Sources/OmarchyVMHelper/ManagedFactoryCache.swift
@@ -0,0 +1,67 @@
+import Darwin
+import Foundation
+
+enum ManagedFactoryCache {
+    static let retention: TimeInterval = 7 * 24 * 60 * 60
+
+    static var downloads: URL {
+        FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent("Downloads", isDirectory: true)
+    }
+
+    static func cacheDirectory(downloads: URL = downloads) -> URL {
+        downloads.appendingPathComponent("Omarchy VM Manager/Factory Images", isDirectory: true)
+    }
+
+    static func directory(for root: URL, downloads: URL = downloads) throws -> URL? {
+        let marker = root.appendingPathComponent(".omarchy-vm-manager.json")
+        var info = stat()
+        guard lstat(marker.path, &info) == 0 else {
+            if errno == ENOENT { return nil }
+            throw HelperError.io("Cannot inspect manager factory-cache configuration")
+        }
+        try ManagedSSHLaunch.directory(root)
+        struct Marker: Decodable { let schemaVersion: Int; let id: UUID }
+        let value = try JSONDecoder().decode(Marker.self, from: ManagedSSHLaunch.read(marker))
+        guard value.schemaVersion == 1, value.id.uuidString == root.lastPathComponent else {
+            throw HelperError.io("The factory download cache requires a valid manager-owned UUID root")
+        }
+        return cacheDirectory(downloads: downloads)
+    }
+
+    static func contains(_ directory: URL) -> Bool {
+        directory.standardizedFileURL == cacheDirectory().standardizedFileURL
+    }
+
+    static func prepare(downloads: URL = downloads) throws {
+        var info = stat()
+        if lstat(downloads.path, &info) != 0, errno == ENOENT {
+            guard mkdir(downloads.path, 0o700) == 0 || errno == EEXIST else {
+                throw HelperError.io("Cannot create the Downloads folder for Omarchy images")
+            }
+        }
+        guard lstat(downloads.path, &info) == 0, info.st_mode & S_IFMT == S_IFDIR,
+              info.st_uid == getuid(), info.st_mode & 0o022 == 0 else {
+            throw HelperError.io("The Omarchy image cache needs an owned Downloads folder without symbolic links or writable access for others")
+        }
+        for directory in [downloads.appendingPathComponent("Omarchy VM Manager", isDirectory: true), cacheDirectory(downloads: downloads)] {
+            if mkdir(directory.path, 0o700) != 0, errno != EEXIST {
+                throw HelperError.io("Cannot create the Omarchy image cache in Downloads")
+            }
+            try ManagedSSHLaunch.directory(directory)
+        }
+    }
+
+    static func validateImageFiles(in directory: URL, identity: String) throws {
+        for file in [FactoryImageStore.imageURL(in: directory, identity: identity), FactoryImageStore.partialURL(in: directory, identity: identity)] {
+            var info = stat()
+            guard lstat(file.path, &info) == 0 else {
+                if errno == ENOENT { continue }
+                throw HelperError.io("Cannot inspect the cached Omarchy image")
+            }
+            guard info.st_mode & S_IFMT == S_IFREG, info.st_uid == getuid(), info.st_nlink == 1,
+                  info.st_mode & 0o7777 == 0o600 else {
+                throw HelperError.io("The cached Omarchy image is unsafe; it was preserved")
+            }
+        }
+    }
+}
