diff --git a/guest/package/try-omarchy/files/usr/lib/try-omarchy/managed-owner-setup b/guest/package/try-omarchy/files/usr/lib/try-omarchy/managed-owner-setup
new file mode 100755
index 0000000..5fe5869
--- /dev/null
+++ b/guest/package/try-omarchy/files/usr/lib/try-omarchy/managed-owner-setup
@@ -0,0 +1,224 @@
+#!/usr/bin/python3 -I
+"""Use reviewed Omarchy OEM functions for an explicitly seeded new guest."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import pwd
+import re
+import stat
+import subprocess
+import sys
+import tempfile
+import uuid
+
+PROGRAM = Path('/usr/bin/omarchy-provision-owner')
+CONTRACT = Path('/usr/share/try-omarchy/owner-setup-contract.json')
+SHARE = Path('/run/try-omarchy/managed-setup-share')
+RUN = Path('/run/try-omarchy/managed-setup')
+PENDING = Path('/var/lib/omarchy/provisioning/pending')
+CMDLINE = Path('/run/try-omarchy/cmdline')
+IDENTITY = Path('/var/lib/try-omarchy/managed-setup/identity.json')
+FAILURE = 'invalid-seed'
+
+
+def read(path, maximum=16384):
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    try:
+        info = os.fstat(fd)
+        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_size > maximum or info.st_mode & 0o077:
+            raise ValueError('private-file')
+        with os.fdopen(fd, 'rb', closefd=False) as stream:
+            value = stream.read(maximum + 1)
+        if len(value) > maximum:
+            raise ValueError('file-size')
+        return value
+    finally:
+        os.close(fd)
+
+
+def directory(path):
+    path.mkdir(mode=0o700, exist_ok=True)
+    info = path.lstat()
+    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
+        raise ValueError('directory')
+
+
+def mount_share():
+    directory(SHARE.parent)
+    if not os.path.ismount(SHARE):
+        directory(SHARE)
+        subprocess.run(['/usr/bin/mount', '-t', '9p', '-o', 'trans=virtio,version=9p2000.L,ro,access=any', 'tryomarchy-managed-setup', str(SHARE)], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
+    info = SHARE.lstat()
+    if not stat.S_ISDIR(info.st_mode) or info.st_mode & 0o022:
+        raise ValueError('share')
+    for line in Path('/proc/self/mountinfo').read_text().splitlines():
+        before, separator, after = line.partition(' - ')
+        fields, filesystem = before.split(), after.split()
+        if separator and len(fields) >= 6 and fields[4] == str(SHARE):
+            if filesystem[:2] == ['9p', 'tryomarchy-managed-setup'] and 'ro' in fields[5].split(','):
+                return
+            break
+    raise ValueError('share')
+
+
+def validate(manifest, seed, contract):
+    if set(manifest) != {'schemaVersion', 'vmID', 'sessionToken', 'fingerprint', 'configuration', 'hostname'} or type(manifest['schemaVersion']) is not int or manifest['schemaVersion'] != 1:
+        raise ValueError('schema')
+    uuid.UUID(manifest['vmID']); uuid.UUID(manifest['sessionToken'])
+    if not re.fullmatch('[0-9a-f]{64}', manifest['fingerprint']):
+        raise ValueError('fingerprint')
+    config = manifest['configuration']
+    if set(config) != {'username', 'fullName', 'email', 'hostnamePrefix', 'timezone', 'keyboardID'} or not all(isinstance(v, str) for v in config.values()):
+        raise ValueError('configuration')
+    if not re.fullmatch('[a-z_][a-z0-9_-]{0,31}', config['username']) or config['username'] == 'root':
+        raise ValueError('username')
+    if not re.fullmatch('[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?', config['hostnamePrefix']):
+        raise ValueError('hostname')
+    if manifest['hostname'] != config['hostnamePrefix'] + '-' + manifest['vmID'][:8].lower():
+        raise ValueError('hostname')
+    for value in (config['fullName'], config['email']):
+        if len(value.encode()) > 256 or any(ord(c) < 32 or ord(c) == 127 for c in value):
+            raise ValueError('single-line')
+    zone = config['timezone']
+    if zone not in ('Same as macOS', 'UTC') and (not re.fullmatch('[A-Za-z0-9_+./-]{1,128}', zone) or '..' in zone.split('/') or zone.startswith('/') or not (Path('/usr/share/zoneinfo') / zone).is_file()):
+        raise ValueError('timezone')
+    keyboards = [k for k in contract['keyboards'] if k['id'] == config['keyboardID']]
+    if len(keyboards) != 1:
+        raise ValueError('keyboard')
+    if set(seed) != {'password'} or not isinstance(seed['password'], str) or not 8 <= len(seed['password'].encode()) <= 1024 or any(c in seed['password'] for c in '\n\r\0'):
+        raise ValueError('password')
+    return keyboards[0]
+
+
+def verified_program(contract):
+    if contract.get('schemaVersion') != 1:
+        raise ValueError('contract')
+    for name, digest in contract['programs'].items():
+        path = Path(name).resolve(strict=True)
+        info = path.stat()
+        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022 or hashlib.sha256(path.read_bytes()).hexdigest() != digest:
+            raise ValueError('contract')
+    if PROGRAM.read_text().splitlines()[-1] != 'main':
+        raise ValueError('entrypoint')
+
+
+def status(manifest, state, failure=None):
+    directory(RUN)
+    value = {k: manifest[k] for k in ('schemaVersion', 'vmID', 'sessionToken', 'fingerprint')}
+    value.update(state=state, owner=manifest['configuration']['username'])
+    if failure:
+        value['failureCode'] = failure
+    fd, temporary = tempfile.mkstemp(dir=RUN, prefix='.status-')
+    try:
+        os.fchmod(fd, 0o644)
+        with os.fdopen(fd, 'w', closefd=False) as stream:
+            json.dump(value, stream); stream.flush(); os.fsync(fd)
+        os.replace(temporary, RUN / 'status.json')
+    finally:
+        os.close(fd)
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+
+
+BASH = r'''
+set +x
+set -euo pipefail
+source <(sed '$d' /usr/bin/omarchy-provision-owner)
+for variable in username password full_name email_address hostname timezone keyboard_label keyboard keyboard_input_method keyboard_xkb_layout; do
+    IFS= read -r -d '' "$variable"
+done
+[[ ! -e $PROVISIONING_DIR/luks-rekey.state && ! -e $PROVISIONING_DIR/luks-device ]] || exit 1
+apply_keyboard "$keyboard"
+omarchy_persist_input_selection
+platform_ready
+touch "$LOG_FILE"
+chmod 600 "$LOG_FILE"
+rm -f "$FINALIZE_WARNING_FLAG"
+echo account >"$STATE_FILE"
+run_provisioning >>"$LOG_FILE" 2>&1
+[[ ! -e $PROVISIONING_DIR/pending && ! -e $FINALIZE_WARNING_FLAG ]]
+'''
+
+
+def provision(manifest, seed, keyboard):
+    config = manifest['configuration']
+    values = [config['username'], seed['password'], config['fullName'], config['email'], manifest['hostname'], config['timezone'], keyboard['id'], keyboard['keymap'], keyboard['inputMethod'], keyboard['xkbLayout']]
+    data = b''.join(v.encode() + b'\0' for v in values)
+    subprocess.run(['/bin/bash', '-c', BASH], input=data, check=True)
+
+
+def record_identity(manifest):
+    directory(IDENTITY.parent)
+    value = {key: manifest[key] for key in ('vmID', 'fingerprint')}
+    value['owner'] = manifest['configuration']['username']
+    fd = os.open(IDENTITY, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+    try:
+        with os.fdopen(fd, 'w', closefd=False) as stream:
+            json.dump(value, stream); stream.flush(); os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+def acknowledge():
+    if not CMDLINE.exists() or 'tryomarchy.managed_setup=1' not in CMDLINE.read_text().split() or PENDING.exists() or not IDENTITY.exists():
+        return
+    mount_share()
+    manifest = json.loads(read(SHARE / 'manifest.json'))
+    identity = json.loads(read(IDENTITY))
+    if manifest.get('schemaVersion') != 1 or any(identity.get(k) != manifest.get(k) for k in ('vmID', 'fingerprint')) or identity.get('owner') != manifest.get('configuration', {}).get('username'):
+        raise ValueError('identity')
+    owner = pwd.getpwnam(identity['owner'])
+    if not 1000 <= owner.pw_uid < 60000:
+        raise ValueError('owner')
+    status(manifest, 'configured')
+
+
+def main():
+    global FAILURE
+    if not CMDLINE.exists() or 'tryomarchy.managed_setup=1' not in CMDLINE.read_text().split() or not PENDING.exists():
+        os.execv(str(PROGRAM), [str(PROGRAM)])
+    manifest = None
+    try:
+        FAILURE = 'unsafe-share'; mount_share()
+        FAILURE = 'invalid-seed'
+        manifest = json.loads(read(SHARE / 'manifest.json'))
+        seed = json.loads(read(SHARE / 'owner-setup.json'))
+        contract = json.loads(CONTRACT.read_bytes())
+        keyboard = validate(manifest, seed, contract)
+        FAILURE = 'contract-mismatch'; verified_program(contract)
+        FAILURE = 'encrypted-image'
+        output = subprocess.run(['/usr/bin/lsblk', '-nr', '-o', 'TYPE'], check=True, capture_output=True, text=True).stdout
+        if 'crypt' in output.split() or (PENDING.parent / 'wipe-pending').exists():
+            raise ValueError('unsupported-image')
+        FAILURE = 'existing-owner'
+        if IDENTITY.exists():
+            raise ValueError('already-provisioned')
+        existing = [p.pw_name for p in pwd.getpwall() if 1000 <= p.pw_uid < 60000 and p.pw_shell not in ('/usr/bin/nologin', '/bin/false', '/usr/sbin/nologin', '/usr/bin/false')]
+        resume = PENDING.parent / 'setup-user'
+        if existing and (existing != [manifest['configuration']['username']] or not resume.exists() or resume.read_text().strip() != existing[0]):
+            raise ValueError('existing-account')
+        status(manifest, 'provisioning')
+        FAILURE = 'provisioning-failed'; provision(manifest, seed, keyboard)
+        if not IDENTITY.exists():
+            record_identity(manifest)
+        status(manifest, 'configured')
+        return 0
+    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
+        if manifest:
+            try:
+                status(manifest, 'error', FAILURE)
+            except (OSError, KeyError, TypeError):
+                pass
+        print('Saved owner setup could not finish (' + FAILURE + '). Continuing with normal Omarchy setup.', file=sys.stderr)
+        os.execv(str(PROGRAM), [str(PROGRAM)])
+
+
+if __name__ == '__main__':
+    if sys.argv[1:] == ['--report']:
+        try:
+            acknowledge()
+        except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
+            sys.exit(1)
+    else:
+        sys.exit(main())
diff --git a/guest/package/try-omarchy/files/usr/lib/try-omarchy/managed-ssh b/guest/package/try-omarchy/files/usr/lib/try-omarchy/managed-ssh
new file mode 100755
index 0000000..0dbca16
--- /dev/null
+++ b/guest/package/try-omarchy/files/usr/lib/try-omarchy/managed-ssh
@@ -0,0 +1,230 @@
+#!/usr/bin/python3 -I
+"""Enroll managed SSH through a per-VM read-only host provisioning share."""
+import json
+import os
+from pathlib import Path
+import pwd
+import re
+import stat
+import subprocess
+import sys
+import tempfile
+import uuid
+
+BASE = Path(os.environ.get("TRY_OMARCHY_MANAGED_STATE", "/var/lib/try-omarchy/managed-ssh"))
+RUN = Path(os.environ.get("TRY_OMARCHY_MANAGED_RUN", "/run/try-omarchy/managed-ssh"))
+SHARE = Path(os.environ.get("TRY_OMARCHY_MANAGED_SHARE", "/run/try-omarchy/managed-ssh-share"))
+CMDLINE = Path(os.environ.get("TRY_OMARCHY_HOST_CMDLINE", "/run/try-omarchy/cmdline"))
+PENDING = Path(os.environ.get("TRY_OMARCHY_OWNER_PENDING", "/var/lib/omarchy/provisioning/pending"))
+SYSTEMCTL = os.environ.get("TRY_OMARCHY_SYSTEMCTL", "/usr/bin/systemctl")
+ROOT = Path(os.environ.get("TRY_OMARCHY_SYSTEM_ROOT", "/"))
+STAGE = "host-settings"
+MOUNTINFO = Path("/proc/self/mountinfo")
+
+
+class ProvisioningError(ValueError):
+    pass
+
+
+def private_directory(path, mode=0o700):
+    path.mkdir(mode=mode, parents=True, exist_ok=True)
+    s = path.lstat()
+    if not stat.S_ISDIR(s.st_mode) or s.st_uid != os.geteuid() or s.st_mode & 0o022:
+        raise ProvisioningError("unsafe-directory")
+
+
+def read(path, limit=16384):
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    try:
+        s = os.fstat(fd)
+        if not stat.S_ISREG(s.st_mode):
+            raise ProvisioningError("file-type")
+        if s.st_nlink != 1:
+            raise ProvisioningError("file-links")
+        if s.st_size > limit:
+            raise ProvisioningError("file-size")
+        with os.fdopen(fd, "rb", closefd=False) as stream:
+            data = stream.read(limit + 1)
+        if len(data) > limit:
+            raise ProvisioningError("file-size")
+        return data
+    finally:
+        os.close(fd)
+
+
+def write(path, data, mode=0o600):
+    if path.exists() and read(path) == data:
+        return
+    fd, temporary = tempfile.mkstemp(prefix=".managed-ssh-", dir=path.parent)
+    try:
+        os.fchmod(fd, mode)
+        with os.fdopen(fd, "wb", closefd=False) as stream:
+            stream.write(data)
+            stream.flush()
+            os.fsync(fd)
+        os.replace(temporary, path)
+    finally:
+        os.close(fd)
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+
+
+def public_key(value):
+    import base64
+    if not isinstance(value, str) or len(value) > 16384 or "\n" in value or "\r" in value:
+        raise ValueError("invalid public key")
+    fields = value.split()
+    if len(fields) < 2 or fields[0] not in ("ssh-ed25519", "ssh-rsa", "ecdsa-sha2-nistp256", "ecdsa-sha2-nistp384", "ecdsa-sha2-nistp521", "sk-ssh-ed25519@openssh.com", "sk-ecdsa-sha2-nistp256@openssh.com"):
+        raise ValueError("unsupported public key")
+    blob = base64.b64decode(fields[1], validate=True)
+    if len(blob) < 16 or int.from_bytes(blob[:4], "big") != len(fields[0]) or blob[4:4 + len(fields[0])].decode() != fields[0]:
+        raise ValueError("invalid public key")
+    return " ".join(fields[:2])
+
+
+def status(manifest, state, owner=None, failure=None):
+    value = {"schemaVersion": 1, "vmID": manifest["vmID"], "sessionToken": manifest["sessionToken"], "state": state}
+    if owner:
+        value["owner"] = owner
+    if failure:
+        value.update(failure)
+    write(RUN / "status.json", (json.dumps(value, separators=(",", ":")) + "\n").encode(), 0o644)
+
+
+def owner_account(binding):
+    candidates = [p for p in pwd.getpwall() if 1000 <= p.pw_uid < 60000 and re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", p.pw_name) and p.pw_shell not in ("/bin/false", "/usr/bin/false", "/usr/sbin/nologin", "/usr/bin/nologin")]
+    if binding.get("owner"):
+        candidates = [p for p in candidates if p.pw_name == binding["owner"]]
+    return candidates[0] if len(candidates) == 1 else None
+
+
+def mount_share():
+    private_directory(SHARE.parent)
+    if not os.path.ismount(SHARE):
+        private_directory(SHARE)
+        subprocess.run(["/usr/bin/mount", "-t", "9p", "-o", "trans=virtio,version=9p2000.L,ro,access=any", "tryomarchy-managed-ssh", str(SHARE)], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
+    info = SHARE.lstat()
+    if not stat.S_ISDIR(info.st_mode) or info.st_mode & 0o022:
+        raise ProvisioningError("unsafe-share")
+    for line in MOUNTINFO.read_text().splitlines():
+        before, separator, after = line.partition(" - ")
+        fields, filesystem = before.split(), after.split()
+        if separator and len(fields) >= 6 and fields[4] == str(SHARE):
+            if len(filesystem) >= 2 and filesystem[:2] == ["9p", "tryomarchy-managed-ssh"] and "ro" in fields[5].split(","):
+                return
+            break
+    raise ProvisioningError("unsafe-share")
+
+
+def main():
+    global STAGE
+    STAGE = "host-settings"
+    if "tryomarchy.managed_ssh=1" not in CMDLINE.read_text().split():
+        return
+    STAGE = "run-directory"
+    private_directory(RUN, 0o755)
+    STAGE = "share-mount"
+    if "TRY_OMARCHY_MANAGED_SHARE" not in os.environ:
+        mount_share()
+    STAGE = "manifest"
+    manifest = json.loads(read(SHARE / "manifest.json"))
+    if set(manifest) != {"schemaVersion", "vmID", "sessionToken", "publicKeys"} or type(manifest["schemaVersion"]) is not int or manifest["schemaVersion"] != 1:
+        raise ValueError("unknown provisioning schema")
+    uuid.UUID(manifest["vmID"]); uuid.UUID(manifest["sessionToken"])
+    if not isinstance(manifest["publicKeys"], list) or not 1 <= len(manifest["publicKeys"]) <= 2:
+        raise ValueError("invalid authorized key list")
+    keys = [public_key(k) for k in manifest["publicKeys"]]
+    STAGE = "identity"
+    private_directory(BASE, 0o755)
+    identity_path = BASE / "identity.json"
+    binding = json.loads(read(identity_path)) if identity_path.exists() else {"vmID": manifest["vmID"]}
+    if binding.get("vmID") != manifest["vmID"]:
+        raise ValueError("VM identity changed")
+    host_key = BASE / "host_ed25519"
+    STAGE = "host-key-read"
+    offered = read(SHARE / "host_ed25519", 8192)
+    expected = public_key(read(SHARE / "host_ed25519.pub").decode().strip())
+    STAGE = "host-key-verify"
+    if host_key.exists():
+        result = subprocess.run(["/usr/bin/ssh-keygen", "-y", "-P", "", "-f", str(host_key)], check=True, capture_output=True, timeout=5)
+        if result.stdout.decode().strip().split()[:2] != expected.split():
+            raise ValueError("SSH host identity changed")
+    else:
+        write(host_key, offered)
+        result = subprocess.run(["/usr/bin/ssh-keygen", "-y", "-P", "", "-f", str(host_key)], check=True, capture_output=True, timeout=5)
+        if result.stdout.decode().strip().split()[:2] != expected.split():
+            raise ValueError("SSH host identity mismatch")
+    write(identity_path, (json.dumps(binding) + "\n").encode())
+    STAGE = "owner"
+    owner = None if PENDING.exists() else owner_account(binding)
+    if owner is None:
+        status(manifest, "waiting-owner")
+        return
+    binding["owner"] = owner.pw_name
+    write(identity_path, (json.dumps(binding) + "\n").encode())
+    STAGE = "authorized-keys"
+    authorized = BASE / "authorized"
+    private_directory(authorized, 0o755)
+    write(authorized / owner.pw_name, ("\n".join(keys) + "\n").encode(), 0o644)
+    STAGE = "daemon-config"
+    config = f"""Port 22
+HostKey {host_key}
+AuthorizedKeysFile .ssh/authorized_keys {authorized}/%u
+PubkeyAuthentication yes
+PasswordAuthentication no
+KbdInteractiveAuthentication no
+PermitRootLogin no
+UsePAM yes
+AllowUsers {owner.pw_name}
+Subsystem sftp internal-sftp
+"""
+    write(RUN / "sshd_config", config.encode())
+    override = ROOT / "run/systemd/system/sshd.service.d"
+    private_directory(override, 0o755)
+    unit = f"[Service]\nExecStart=\nExecStart=/usr/bin/sshd -D -f {RUN}/sshd_config\n"
+    previous = read(override / "90-try-omarchy-managed.conf") if (override / "90-try-omarchy-managed.conf").exists() else b""
+    write(override / "90-try-omarchy-managed.conf", unit.encode(), 0o644)
+    STAGE = "daemon-check"
+    subprocess.run(["/usr/bin/sshd", "-t", "-f", str(RUN / "sshd_config")], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
+    STAGE = "daemon-start"
+    if previous != unit.encode():
+        subprocess.run([SYSTEMCTL, "daemon-reload"], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
+        subprocess.run([SYSTEMCTL, "restart", "sshd.service"], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
+    else:
+        subprocess.run([SYSTEMCTL, "start", "sshd.service"], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
+    status(manifest, "configured", owner.pw_name)
+
+
+def run():
+    try:
+        main()
+        return 0
+    except Exception as error:
+        code = "unexpected"
+        number = None
+        if isinstance(error, ProvisioningError):
+            code = str(error)
+        elif isinstance(error, ValueError):
+            code = "invalid-data"
+        elif isinstance(error, subprocess.CalledProcessError):
+            code = "command-failed"
+            number = error.returncode
+        elif isinstance(error, subprocess.TimeoutExpired):
+            code = "timeout"
+        elif isinstance(error, OSError):
+            code = "file-access"
+            number = error.errno
+        failure = {"failureStage": STAGE, "failureCode": code}
+        if isinstance(number, int) and -255 <= number <= 255:
+            failure["failureStatus"] = number
+        try:
+            manifest = json.loads(read(SHARE / "manifest.json"))
+            status(manifest, "error", failure=failure)
+        except Exception:
+            pass
+        print("try-omarchy-managed-ssh: provisioning failed at " + STAGE + " (" + code + "); identities were preserved", file=sys.stderr)
+        return 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(run())
