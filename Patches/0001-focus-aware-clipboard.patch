+        focus.probes = [true, true, false]
+        try route.handle(.clipboard(guest))
+        #expect(host.writes == 0)
+        #expect(host.message?.text == "host")
+        focus.probes = [true, true, true, false]
+        try route.poll()
+        #expect(output.messages.count == 1)
+    }
+
+    @Test("sync is gated and foreground echoes stay suppressed")
+    func syncAndEcho() throws {
+        let host = ClipboardTestPasteboard(), focus = ClipboardTestFocus()
+        let output = ClipboardTestOutput()
+        let route = FocusedClipboardRouting(pasteboard: host, focus: focus, send: output.send)
+        host.copy("selection")
+        try route.handle(.sync)
+        #expect(host.reads == 0)
+        focus.focused = true
+        try route.handle(.sync)
+        #expect(output.messages.count == 1)
+        try route.handle(.clipboard(host.message!))
+        #expect(host.writes == 0)
+        try route.handle(.sync)
+        #expect(output.messages.count == 2)
+        focus.focused = false
+        try route.handle(.sync)
+        #expect(output.messages.count == 2)
+    }
+}
