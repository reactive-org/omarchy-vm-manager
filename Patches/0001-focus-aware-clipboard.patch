+protocol ClipboardFocusProviding: AnyObject {
+    func isFocused() -> Bool
+}
+
+final class QEMUClipboardFocus: ClipboardFocusProviding {
+    private let processIdentity: KernelProcessIdentity
+    private let frontmostProcessIdentifier: () -> pid_t?
+
+    init(
+        processIdentity: KernelProcessIdentity,
+        frontmostProcessIdentifier: @escaping () -> pid_t? = {
+            NSWorkspace.shared.frontmostApplication?.processIdentifier
+        }
+    ) {
+        self.processIdentity = processIdentity
+        self.frontmostProcessIdentifier = frontmostProcessIdentifier
+    }
+
+    func isFocused() -> Bool {
+        ClipboardMainRunLoop.readOnMain {
+            processIdentity.isStillRunning &&
+                frontmostProcessIdentifier() == processIdentity.processIdentifier
+        }
+    }
+}
