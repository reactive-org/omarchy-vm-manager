+    @Test("rapid focus changes synchronize once per observed activation")
+    func rapidSwitches() throws {
+        let host = ClipboardTestPasteboard()
+        let fa = ClipboardTestFocus(), fb = ClipboardTestFocus()
+        let oa = ClipboardTestOutput(), ob = ClipboardTestOutput()
+        let a = FocusedClipboardRouting(pasteboard: host, focus: fa, send: oa.send)
+        let b = FocusedClipboardRouting(pasteboard: host, focus: fb, send: ob.send)
+        host.copy("current")
+        for i in 0..<20 {
