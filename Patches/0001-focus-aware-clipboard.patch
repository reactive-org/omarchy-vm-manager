+import Darwin
+import Foundation
+import Testing
+@testable import OmarchyVMHelper
+
+@Suite("Unattended owner launch boundary")
+struct ManagedSetupLaunchTests {
+    @Test("an environment override cannot attach a setup share")
+    func ignoresEnvironment() throws {
+        let root = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        #expect(try ManagedSetupLaunch.environment(root: root, base: [ManagedSetupLaunch.environmentKey: "/unsafe"]) == [:])
+    }
+    @Test("matching private seed identity is required and cleanup refuses another session")
+    func launchAndCleanup() throws {
+        let root = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        let bootstrap = root.appendingPathComponent(".manager-setup/bootstrap")
+        try FileManager.default.createDirectory(at: bootstrap, withIntermediateDirectories: true, attributes: [.posixPermissions: 0o700])
+        defer { try? FileManager.default.removeItem(at: root) }
+        chmod(root.path, 0o700); chmod(root.appendingPathComponent(".manager-setup").path, 0o700)
+        let id = UUID(uuidString: root.lastPathComponent)!, token = UUID()
+        let config = ManagedSetupLaunch.Configuration(username: "owner", fullName: "Synthetic Owner", email: "owner@example.invalid", hostnamePrefix: "work", timezone: "UTC", keyboardID: "English (US)")
+        let manifest = ManagedSetupLaunch.Manifest(schemaVersion: 1, vmID: id, sessionToken: token, fingerprint: String(repeating: "a", count: 64), configuration: config, hostname: "work-" + id.uuidString.prefix(8).lowercased())
+        func write(_ data: Data, _ path: URL) throws { try data.write(to: path); chmod(path.path, 0o600) }
+        let marker = root.appendingPathComponent(".omarchy-managed-setup.json"), seed = bootstrap.appendingPathComponent("owner-setup.json")
+        try write(JSONEncoder().encode(manifest), marker)
+        try write(JSONEncoder().encode(manifest), bootstrap.appendingPathComponent("manifest.json"))
+        try write(Data(#"{"password":"synthetic-password"}"#.utf8), seed)
+        #expect(try ManagedSetupLaunch.environment(root: root, base: [:])[ManagedSetupLaunch.environmentKey] == bootstrap.path)
+        chmod(seed.path, 0o644)
+        #expect(throws: (any Error).self) { try ManagedSetupLaunch.environment(root: root, base: [:]) }
+        chmod(seed.path, 0o600)
+        let other = ManagedSetupLaunch.Manifest(schemaVersion: 1, vmID: id, sessionToken: UUID(), fingerprint: manifest.fingerprint, configuration: config, hostname: manifest.hostname)
+        #expect(throws: (any Error).self) { try ManagedSetupLaunch.clearSeed(root: root, expected: other) }
+        #expect(FileManager.default.fileExists(atPath: seed.path))
+        try ManagedSetupLaunch.clearSeed(root: root, expected: manifest)
+        #expect(!FileManager.default.fileExists(atPath: seed.path))
+        #expect(!FileManager.default.fileExists(atPath: marker.path))
+    }
+    @Test("guest setup status accepts only known non-secret fields")
+    func guestStatus() throws {
+        var value: [String: Any] = ["schemaVersion": 1, "vmID": UUID().uuidString, "sessionToken": UUID().uuidString, "fingerprint": String(repeating: "a", count: 64), "state": "error", "owner": "owner", "failureCode": "contract-mismatch"]
+        func decode() throws -> ShellGuestReport { try ShellGuestReport.decode(JSONSerialization.data(withJSONObject: ["protocol": 1, "managedSetup": value])) }
+        #expect(try decode().managedSetup?.failureCode == "contract-mismatch")
+        value["failureCode"] = "untrusted-private-message"
+        #expect(throws: (any Error).self) { try decode() }
+        value["failureCode"] = "invalid-seed"; value["owner"] = "root"
+        #expect(throws: (any Error).self) { try decode() }
+    }
+}
