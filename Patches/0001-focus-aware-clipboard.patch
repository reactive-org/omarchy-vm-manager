@@ -0,0 +1,30 @@
+import Foundation
+import Testing
+import TryOmarchyKitClient
+
+@Suite("Manual execution run protocol")
+struct ExecutionProtocolTests {
+    @Test("pause and resume use the existing bounded command channel", arguments: [VMRunCommand.pause, .resume])
+    func commands(_ command: VMRunCommand) throws {
+        #expect(try VMRunCommand.decode(line: command.encodedLine()) == command)
+    }
+    @Test("execution acknowledgements round trip with a nonfatal error")
+    func acknowledgements() throws {
+        for state in VMRunExecutionState.allCases {
+            for command in [VMRunCommand.pause, .resume] {
+                let failure = VMRunError(code: .launchFailed, message: "synthetic failure", reportedCode: "execution-control-failed")
+                let event = VMRunEvent.executionState(VMRunExecutionReport(state: state, command: command, failure: failure))
+                #expect(try VMRunEvent.decode(line: event.encodedLine()) == event)
+            }
+            let event = VMRunEvent.executionState(VMRunExecutionReport(state: state))
+            #expect(try VMRunEvent.decode(line: event.encodedLine()) == event)
+        }
+    }
+    @Test("damaged execution reports cannot acknowledge a command")
+    func invalidReports() throws {
+        for extra in [#""state":"running","command":"pause""#, #""state":"paused","command":"resume""#, #""state":"paused","unexpected":true"#, #""state":"other""#, #""state":"paused","command":"shutdown""#, #""state":"running","command":"resume","errorMessage":"missing code""#, #""state":"paused","errorCode":"error","errorMessage":"no command""#] {
+            let data = Data((#"{"version":1,"event":"execution-state", "# + extra + "}").utf8)
+            #expect(throws: VMRunProtocolError.self) { try VMRunEvent.decode(line: data) }
+        }
+    }
+}
