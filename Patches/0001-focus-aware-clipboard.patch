+        let aFocus = ClipboardTestFocus(), bFocus = ClipboardTestFocus()
+        let aOutput = ClipboardTestOutput(), bOutput = ClipboardTestOutput()
+        let a = FocusedClipboardRouting(pasteboard: host, focus: aFocus, send: aOutput.send)
+        let b = FocusedClipboardRouting(pasteboard: host, focus: bFocus, send: bOutput.send)
+        host.copy("host one")
+        try a.poll(); try b.poll()
+        #expect(host.reads == 0)
+        aFocus.focused = true
+        try a.poll(); try a.poll(); try b.poll()
+        #expect(aOutput.messages.map(\.text) == ["host one"])
+        #expect(bOutput.messages.isEmpty)
+        host.copy("host two")
+        try a.poll(); try b.handle(.sync)
+        #expect(aOutput.messages.map(\.text) == ["host one", "host two"])
+        let background = ClipboardMessage(format: .text, payload: Data("background".utf8))!
+        try b.handle(.clipboard(background))
+        #expect(host.message?.text == "host two")
+        #expect(host.writes == 0)
+        let guest = ClipboardMessage(format: .text, payload: Data("guest A".utf8))!
+        try a.handle(.clipboard(guest))
+        try a.poll(); try b.poll()
+        #expect(host.message == guest)
+        #expect(aOutput.messages.count == 2)
+        aFocus.focused = false; bFocus.focused = true
+        try a.poll(); try b.poll(); try b.poll()
+        #expect(bOutput.messages.map(\.text) == ["guest A"])
+        #expect(host.writes == 1)
+        let guestB = ClipboardMessage(format: .text, payload: Data("guest B".utf8))!
+        try b.handle(.clipboard(guestB))
+        #expect(host.message == guestB)
+        try a.handle(.clipboard(background))
+        #expect(host.message == guestB)
+    }
+
+    @Test("rapid focus changes synchronize once per observed activation")
+    func rapidSwitches() throws {
+        let host = ClipboardTestPasteboard()
+        let fa = ClipboardTestFocus(), fb = ClipboardTestFocus()
+        let oa = ClipboardTestOutput(), ob = ClipboardTestOutput()
+        let a = FocusedClipboardRouting(pasteboard: host, focus: fa, send: oa.send)
+        let b = FocusedClipboardRouting(pasteboard: host, focus: fb, send: ob.send)
+        host.copy("current")
