+import Foundation
+import Testing
+import TryOmarchyKitClient
+
+@Suite("Guest launch intent protocol")
+struct LaunchIntentProtocolTests {
+    @Test("intent defaults to background and round trips explicitly")
+    func configurations() throws {
+        var configuration = VMRunConfiguration(productName: "Guest")
+        #expect(configuration.launchIntent == .background)
+        for intent in [VMRunLaunchIntent.background, .foreground] {
+            configuration.launchIntent = intent
+            #expect(try VMRunConfiguration.decode(line: configuration.encodedLine()) == configuration)
+        }
+        var object = try JSONSerialization.jsonObject(with: configuration.encodedLine()) as! [String: Any]
+        object.removeValue(forKey: "launchIntent")
+        #expect(try VMRunConfiguration.decode(line: JSONSerialization.data(withJSONObject: object)).launchIntent == .background)
+        for value: Any in ["other", 1, true, NSNull()] {
+            object["launchIntent"] = value
+            #expect(throws: VMRunProtocolError.self) { try VMRunConfiguration.decode(line: JSONSerialization.data(withJSONObject: object)) }
+        }
+    }
+
+    @Test("display identity round trips and malformed identities fail closed")
+    func identities() throws {
+        let event = VMRunEvent.displayReady(VMRunDisplayProcess(processIdentifier: 123, startSeconds: 1000, startMicroseconds: 123456))
+        #expect(try VMRunEvent.decode(line: event.encodedLine()) == event)
+        var object = try JSONSerialization.jsonObject(with: event.encodedLine()) as! [String: Any]
+        for (key, values) in [("pid", [0, 1, -1, 2147483648, true] as [Any]), ("startSeconds", [0, -1, true]), ("startMicroseconds", [-1, 1000000, true])] {
+            for value in values {
+                var broken = object; broken[key] = value
+                #expect(throws: VMRunProtocolError.self) { try VMRunEvent.decode(line: JSONSerialization.data(withJSONObject: broken)) }
+            }
+        }
+        object.removeValue(forKey: "startSeconds")
+        #expect(throws: VMRunProtocolError.self) { try VMRunEvent.decode(line: JSONSerialization.data(withJSONObject: object)) }
+    }
+}
