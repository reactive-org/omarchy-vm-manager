+import Darwin
+import Foundation
+import Testing
+@testable import OmarchyVMHelper
+
+@Suite("Managed SSH launch boundary")
+struct ManagedSSHLaunchTests {
+    @Test("public environment cannot supply a provisioning share")
+    func ignoresEnvironment() throws {
+        let root = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        #expect(try ManagedSSHLaunch.environment(root: root, mappings: [], base: [ManagedSSHLaunch.environmentKey: "/unsafe"]) == [:])
+    }
+    @Test("private UUID metadata requires the exact SSH mapping and matching session")
+    func validatesProvisioning() throws {
+        let id = UUID(), session = UUID()
+        let root = FileManager.default.temporaryDirectory.appendingPathComponent(id.uuidString)
+        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true, attributes: [.posixPermissions: 0o700])
+        defer { try? FileManager.default.removeItem(at: root) }
+        let bootstrap = root.appendingPathComponent(".manager-ssh/bootstrap")
+        try FileManager.default.createDirectory(at: bootstrap, withIntermediateDirectories: true, attributes: [.posixPermissions: 0o700])
+        chmod(root.appendingPathComponent(".manager-ssh").path, 0o700)
+        func write(_ value: Any, _ path: URL) throws {
+            try JSONSerialization.data(withJSONObject: value).write(to: path)
+            chmod(path.path, 0o600)
+        }
+        try write(["schemaVersion": 1, "vmID": id.uuidString, "sessionToken": session.uuidString, "hostPort": 2223], root.appendingPathComponent(".omarchy-managed-ssh.json"))
+        func manifest(_ token: UUID) throws {
+            try write(["schemaVersion": 1, "vmID": id.uuidString, "sessionToken": token.uuidString, "publicKeys": ["synthetic-public-key"]], bootstrap.appendingPathComponent("manifest.json"))
+        }
+        try manifest(session)
+        for name in ["host_ed25519", "host_ed25519.pub"] {
+            let path = bootstrap.appendingPathComponent(name)
+            try Data("synthetic".utf8).write(to: path); chmod(path.path, 0o600)
+        }
+        let mappings = [PortForwardMapping(hostPort: 2223, guestPort: 22, protocol: .tcp)]
+        #expect(try ManagedSSHLaunch.environment(root: root, mappings: mappings, base: [:])[ManagedSSHLaunch.environmentKey] == bootstrap.path)
+        #expect(throws: (any Error).self) { try ManagedSSHLaunch.environment(root: root, mappings: [], base: [:]) }
+        try manifest(UUID())
+        #expect(throws: (any Error).self) { try ManagedSSHLaunch.environment(root: root, mappings: mappings, base: [:]) }
+        try manifest(session); chmod(bootstrap.appendingPathComponent("host_ed25519").path, 0o644)
+        #expect(throws: (any Error).self) { try ManagedSSHLaunch.environment(root: root, mappings: mappings, base: [:]) }
+    }
+    @Test("untrusted guest SSH status rejects unknown versions and privileged owners", arguments: ["root", "owner;command", "owner\\nnext"])
+    func rejectsGuestOwners(_ owner: String) throws {
+        let object: [String: Any] = ["protocol": 1, "managedSSH": ["schemaVersion": 1, "vmID": UUID().uuidString, "sessionToken": UUID().uuidString, "state": "configured", "owner": owner]]
+        #expect(throws: (any Error).self) { try ShellGuestReport.decode(JSONSerialization.data(withJSONObject: object)) }
+    }
+}
+
+@Suite("Managed SSH failure transport")
+struct ManagedSSHFailureTests {
+    @Test("only known bounded diagnostic fields cross the guest status boundary")
+    func diagnostics() throws {
+        var ssh: [String: Any] = ["schemaVersion": 1, "vmID": UUID().uuidString, "sessionToken": UUID().uuidString, "state": "error", "failureStage": "host-key-read", "failureCode": "file-access", "failureStatus": 13]
+        func decode(_ value: [String: Any]) throws -> ShellGuestReport { try ShellGuestReport.decode(JSONSerialization.data(withJSONObject: ["protocol": 1, "managedSSH": value])) }
+        #expect(try decode(ssh).managedSSH?.failureStage == "host-key-read")
+        for (key, value) in [("failureStage", "private-data" as Any), ("failureCode", "private-data" as Any), ("failureStatus", 256 as Any)] {
+            var invalid = ssh; invalid[key] = value
+            #expect(throws: (any Error).self) { try decode(invalid) }
+        }
+        ssh["failureStatus"] = -9
+        #expect(try decode(ssh).managedSSH?.failureStatus == -9)
+    }
+}
