+#!/usr/bin/python3 -I
+"""Use reviewed Omarchy OEM functions for an explicitly seeded new guest."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import pwd
+import re
+import stat
+import subprocess
+import sys
+import tempfile
+import uuid
+
+PROGRAM = Path('/usr/bin/omarchy-provision-owner')
+CONTRACT = Path('/usr/share/try-omarchy/owner-setup-contract.json')
+OFFICIAL = 'd381667f407b5f82cfb9f9c391eccf2898ba8a064bc6b2f082e28f959e76aef8'
+LEAN = '1347cb16b831eb2c3a67344a5bbb68c9da776a55221ecab5ba90ce385078d310'
+CONTRACTS = {OFFICIAL: (CONTRACT, 'official'), LEAN: (CONTRACT.with_name('lean-owner-setup-contract.json'), 'lean-e4fffc6')}
+SHARE = Path('/run/try-omarchy/managed-setup-share')
+RUN = Path('/run/try-omarchy/managed-setup')
+PENDING = Path('/var/lib/omarchy/provisioning/pending')
+CMDLINE = Path('/run/try-omarchy/cmdline')
+IDENTITY = Path('/var/lib/try-omarchy/managed-setup/identity.json')
+BOOT_ID = Path('/proc/sys/kernel/random/boot_id')
+REPORT_NAME = 'report-session.json'
+FAILURE = 'invalid-seed'
+
+
+def read(path, maximum=16384, owned=False):
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    try:
+        info = os.fstat(fd)
+        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_size > maximum or info.st_mode & 0o077 or (owned and info.st_uid != os.geteuid()):
+            raise ValueError('private-file')
+        with os.fdopen(fd, 'rb', closefd=False) as stream:
+            value = stream.read(maximum + 1)
+        if len(value) > maximum:
+            raise ValueError('file-size')
+        return value
+    finally:
+        os.close(fd)
+
+
+def directory(path):
+    path.mkdir(mode=0o700, exist_ok=True)
+    info = path.lstat()
+    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
+        raise ValueError('directory')
+
+
+def mount_share():
+    directory(SHARE.parent)
+    if not os.path.ismount(SHARE):
+        directory(SHARE)
+        subprocess.run(['/usr/bin/mount', '-t', '9p', '-o', 'trans=virtio,version=9p2000.L,ro,access=any', 'tryomarchy-managed-setup', str(SHARE)], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
+    info = SHARE.lstat()
+    if not stat.S_ISDIR(info.st_mode) or info.st_mode & 0o022:
+        raise ValueError('share')
+    for line in Path('/proc/self/mountinfo').read_text().splitlines():
+        before, separator, after = line.partition(' - ')
+        fields, filesystem = before.split(), after.split()
+        if separator and len(fields) >= 6 and fields[4] == str(SHARE):
+            if filesystem[:2] == ['9p', 'tryomarchy-managed-setup'] and 'ro' in fields[5].split(','):
+                return
+            break
+    raise ValueError('share')
+
+
+def validate(manifest, seed, contract):
+    if set(manifest) - {'ownerSetupContractSHA256'} != {'schemaVersion', 'vmID', 'sessionToken', 'fingerprint', 'configuration', 'hostname'} or type(manifest['schemaVersion']) is not int or manifest['schemaVersion'] != 1:
+        raise ValueError('schema')
+    uuid.UUID(manifest['vmID']); uuid.UUID(manifest['sessionToken'])
+    if not re.fullmatch('[0-9a-f]{64}', manifest['fingerprint']):
+        raise ValueError('fingerprint')
+    config = manifest['configuration']
+    if set(config) != {'username', 'fullName', 'email', 'hostnamePrefix', 'timezone', 'keyboardID'} or not all(isinstance(v, str) for v in config.values()):
+        raise ValueError('configuration')
+    if not re.fullmatch('[a-z_][a-z0-9_-]{0,31}', config['username']) or config['username'] == 'root':
+        raise ValueError('username')
+    if not re.fullmatch('[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?', config['hostnamePrefix']):
+        raise ValueError('hostname')
+    if manifest['hostname'] != config['hostnamePrefix'] + '-' + manifest['vmID'][:8].lower():
+        raise ValueError('hostname')
+    for value in (config['fullName'], config['email']):
+        if len(value.encode()) > 256 or any(ord(c) < 32 or ord(c) == 127 for c in value):
+            raise ValueError('single-line')
+    zone = config['timezone']
+    if zone not in ('Same as macOS', 'UTC') and (not re.fullmatch('[A-Za-z0-9_+./-]{1,128}', zone) or '..' in zone.split('/') or zone.startswith('/') or not (Path('/usr/share/zoneinfo') / zone).is_file()):
+        raise ValueError('timezone')
+    keyboards = [k for k in contract['keyboards'] if k['id'] == config['keyboardID']]
+    if len(keyboards) != 1:
+        raise ValueError('keyboard')
+    if set(seed) != {'password'} or not isinstance(seed['password'], str) or not 8 <= len(seed['password'].encode()) <= 1024 or any(c in seed['password'] for c in '\n\r\0'):
+        raise ValueError('password')
+    return keyboards[0]
+
+
+def reviewed_bytes(path, maximum=131072):
+    path = Path(path)
+    for parent in path.parents:
+        info = parent.lstat()
+        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
+            raise ValueError('program-parent')
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
+    try:
+        before = os.fstat(fd)
+        if not stat.S_ISREG(before.st_mode) or before.st_uid != 0 or before.st_nlink != 1 or before.st_mode & 0o7022 or not 0 < before.st_size <= maximum:
+            raise ValueError('program-file')
+        with os.fdopen(fd, 'rb', closefd=False) as stream:
+            value = stream.read(maximum + 1)
+        after = os.fstat(fd)
+        if len(value) != before.st_size or (before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (after.st_size, after.st_mtime_ns, after.st_ctime_ns):
+            raise ValueError('program-changed')
+        return value
+    finally:
+        os.close(fd)
+
+
+def selected_contract(manifest):
+    digest = manifest.get('ownerSetupContractSHA256', OFFICIAL)
+    if not isinstance(digest, str) or digest not in CONTRACTS:
+        raise ValueError('contract')
+    path, adapter = CONTRACTS[digest]
+    data = reviewed_bytes(path)
+    if hashlib.sha256(data).hexdigest() != digest:
+        raise ValueError('contract')
+    return json.loads(data), adapter
+
+
+def verified_program(contract):
+    if type(contract.get('schemaVersion')) is not int or contract['schemaVersion'] != 1:
+        raise ValueError('contract')
+    programs = {name: reviewed_bytes(name) for name in contract['programs']}
+    for name, value in programs.items():
+        if hashlib.sha256(value).hexdigest() != contract['programs'][name]:
+            raise ValueError('contract')
+    if programs[str(PROGRAM)].decode().splitlines()[-1] != 'main':
+        raise ValueError('entrypoint')
+    return programs
+
+
+def status(manifest, state, failure=None):
+    directory(RUN)
+    value = {k: manifest[k] for k in ('schemaVersion', 'vmID', 'sessionToken', 'fingerprint')}
+    value.update(state=state, owner=manifest['configuration']['username'])
+    if failure:
+        value['failureCode'] = failure
+    fd, temporary = tempfile.mkstemp(dir=RUN, prefix='.status-')
+    try:
+        os.fchmod(fd, 0o644)
+        with os.fdopen(fd, 'w', closefd=False) as stream:
+            json.dump(value, stream); stream.flush(); os.fsync(fd)
+        os.replace(temporary, RUN / 'status.json')
+    finally:
+        os.close(fd)
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+
+
+BASH = r'''
+set +x
+set -euo pipefail
+export OMARCHY_PATH=/usr/share/omarchy
+source "$1"
+for function in apply_keyboard omarchy_persist_input_selection platform_ready run_provisioning cleanup_oem_state create_user finalize_user; do
+    declare -F "$function" >/dev/null || exit 1
+done
+managed_adapter=$2
+eval "$(declare -f cleanup_oem_state | sed '1s/^cleanup_oem_state/managed_upstream_cleanup_oem_state/')"
+cleanup_oem_state() {
+    [[ ! -e $FINALIZE_WARNING_FLAG ]] || return 1
+    if [[ $managed_adapter == lean-e4fffc6 ]]; then
+        [[ -z $full_name ]] || usermod -c "$full_name" "$username"
+        local home
+        home=$(getent passwd "$username" | cut -d: -f6)
+        [[ $home == /* && -d $home ]] || return 1
+        [[ -z $full_name ]] || runuser -u "$username" -- env HOME="$home" git config --global -- user.name "$full_name"
+        [[ -z $email_address ]] || runuser -u "$username" -- env HOME="$home" git config --global -- user.email "$email_address"
+    fi
+    /usr/lib/try-omarchy/managed-owner-setup --commit
+    managed_upstream_cleanup_oem_state
+}
+for variable in username password full_name email_address hostname timezone keyboard_label keyboard keyboard_input_method keyboard_xkb_layout; do
+    IFS= read -r -d '' "$variable"
+done
+[[ ! -e $PROVISIONING_DIR/luks-rekey.state && ! -e $PROVISIONING_DIR/luks-device ]] || exit 1
+touch "$LOG_FILE"
+chmod 600 "$LOG_FILE"
+apply_keyboard "$keyboard"
+omarchy_persist_input_selection
+platform_ready
+rm -f "$FINALIZE_WARNING_FLAG"
+echo account >"$STATE_FILE"
+run_provisioning >>"$LOG_FILE" 2>&1
+[[ ! -e $PROVISIONING_DIR/pending && ! -e $FINALIZE_WARNING_FLAG ]]
+'''
+
+
+def provision(manifest, seed, keyboard, programs, adapter):
+    config = manifest['configuration']
+    values = [config['username'], seed['password'], config['fullName'], config['email'], manifest['hostname'], config['timezone'], keyboard['id'], keyboard['keymap'], keyboard['inputMethod'], keyboard['xkbLayout']]
+    data = b''.join(v.encode() + b'\0' for v in values)
+    with tempfile.TemporaryDirectory(prefix='owner-programs-', dir=RUN) as folder:
+        snapshots = {}
+        for index, (name, value) in enumerate(programs.items()):
+            snapshot = Path(folder) / str(index)
+            snapshot.write_bytes(value); snapshot.chmod(0o600)
+            snapshots[name] = snapshot
+        source = programs[str(PROGRAM)].decode().rsplit('\nmain', 1)[0] + '\n'
+        for name, snapshot in snapshots.items():
+            if name.startswith('/usr/share/omarchy/install/provisioning/'):
+                statement = 'source "$OMARCHY_PATH/install/provisioning/' + Path(name).name + '"'
+                if source.count(statement) != 1:
+                    raise ValueError('interface')
+                source = source.replace(statement, 'source "' + str(snapshot) + '"')
+        if adapter == 'lean-e4fffc6':
+            call = '"$OMARCHY_PATH/bin/omarchy-provision-user" --force --first-install'
+            if source.count(call) != 1:
+                raise ValueError('finalizer-interface')
+            source = source.replace(call, '/usr/bin/omarchy-provision-user --force --first-install')
+        snapshots[str(PROGRAM)].write_text(source)
+        subprocess.run(['/bin/bash', '-c', BASH, 'managed-owner-setup', str(snapshots[str(PROGRAM)]), adapter], input=data, check=True)
+
+
+def identity_value(manifest):
+    value = {key: manifest[key] for key in ('vmID', 'fingerprint')}
+    value['owner'] = manifest['configuration']['username']
+    value['ownerSetupContractSHA256'] = manifest.get('ownerSetupContractSHA256', OFFICIAL)
+    return value
+
+
+def matching_identity(manifest):
+    directory(IDENTITY.parent)
+    if json.loads(read(IDENTITY)) != identity_value(manifest):
+        raise ValueError('identity')
+
+
+def record_identity(manifest):
+    directory(IDENTITY.parent)
+    value = identity_value(manifest)
+    fd = os.open(IDENTITY, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+    try:
+        with os.fdopen(fd, 'w', closefd=False) as stream:
+            json.dump(value, stream); stream.flush(); os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+def commit_identity():
+    mount_share()
+    manifest = json.loads(read(SHARE / 'manifest.json'))
+    selected_contract(manifest)
+    if not PENDING.exists() or Path('/run/omarchy-provision-owner.finalize-warning').exists():
+        raise ValueError('cleanup-state')
+    owner = pwd.getpwnam(manifest['configuration']['username'])
+    if not 1000 <= owner.pw_uid < 60000:
+        raise ValueError('owner')
+    if IDENTITY.exists():
+        matching_identity(manifest)
+    else:
+        record_identity(manifest)
+    for path in (IDENTITY, IDENTITY.parent):
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+        try:
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+
+    retain_report_binding(report_binding(manifest))
+
+
+def cleanup_finished():
+    return not any(path.exists() for path in [PENDING, PENDING.parent / 'setup-user', PENDING.parent / 'authorized_keys', PENDING.parent / 'luks-rekey.state', Path('/run/omarchy-provision-owner.finalize-warning')])
+
+
+def boot_id():
+    with BOOT_ID.open() as stream:
+        return str(uuid.UUID(stream.read(128).strip()))
+
+
+def report_binding(manifest):
+    if not isinstance(manifest, dict) or not isinstance(manifest.get('configuration'), dict) or any(not isinstance(manifest.get(key), str) for key in ('vmID', 'sessionToken', 'fingerprint')):
+        raise ValueError('report-manifest')
+    return {'schemaVersion': manifest['schemaVersion'], 'vmID': str(uuid.UUID(manifest['vmID'])).upper(),
+            'sessionToken': str(uuid.UUID(manifest['sessionToken'])).upper(), 'fingerprint': manifest['fingerprint'],
+            'owner': manifest['configuration']['username'], 'ownerSetupContractSHA256': manifest.get('ownerSetupContractSHA256', OFFICIAL)}
+
+
+def binding_digest(binding):
+    return hashlib.sha256(json.dumps(binding, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
+
+
+def validate_report_binding(binding):
+    if set(binding) != {'schemaVersion', 'vmID', 'sessionToken', 'fingerprint', 'owner', 'ownerSetupContractSHA256'} or type(binding['schemaVersion']) is not int or binding['schemaVersion'] != 1:
+        raise ValueError('report-schema')
+    for key in ('vmID', 'sessionToken'):
+        if not isinstance(binding[key], str) or str(uuid.UUID(binding[key])).upper() != binding[key]:
+            raise ValueError('report-uuid')
+    if not isinstance(binding['fingerprint'], str) or not re.fullmatch('[0-9a-f]{64}', binding['fingerprint']):
+        raise ValueError('report-fingerprint')
+    if not isinstance(binding['owner'], str) or not re.fullmatch('[a-z_][a-z0-9_-]{0,31}', binding['owner']) or binding['owner'] == 'root':
+        raise ValueError('report-owner')
+    selected_contract(binding)
+    tokens = [token.partition('=')[2] for token in CMDLINE.read_text().split() if token.startswith('tryomarchy.managed_setup_report=')]
+    if len(tokens) != 1 or not re.fullmatch('[0-9a-f]{64}', tokens[0]) or tokens[0] != binding_digest(binding):
+        raise ValueError('report-session')
+
+
+def local_report_binding():
+    directory(RUN)
+    receipt = json.loads(read(RUN / REPORT_NAME, owned=True))
+    if not isinstance(receipt, dict) or set(receipt) != {'bootID', 'binding'} or receipt['bootID'] != boot_id():
+        raise ValueError('report-boot')
+    binding = receipt['binding']
+    validate_report_binding(binding)
+    return binding
+
+
+def retain_report_binding(binding):
+    validate_report_binding(binding)
+    directory(RUN)
+    path = RUN / REPORT_NAME
+    if os.path.lexists(path):
+        if local_report_binding() != binding:
+            raise ValueError('report-changed')
+    else:
+        fd, temporary = tempfile.mkstemp(dir=RUN, prefix='.report-')
+        try:
+            os.fchmod(fd, 0o600)
+            with os.fdopen(fd, 'w', closefd=False) as stream:
+                json.dump({'bootID': boot_id(), 'binding': binding}, stream); stream.flush(); os.fsync(fd)
+            os.replace(temporary, path)
+        finally:
+            os.close(fd)
+            if os.path.exists(temporary): os.unlink(temporary)
+    for target in (path, RUN):
+        fd = os.open(target, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+        try: os.fsync(fd)
+        finally: os.close(fd)
+
+
+def report_completion(binding):
+    validate_report_binding(binding)
+    if not cleanup_finished(): raise ValueError('cleanup-state')
+    directory(IDENTITY.parent)
+    identity = json.loads(read(IDENTITY, owned=True))
+    if not isinstance(identity, dict): raise ValueError('identity')
+    identity.setdefault('ownerSetupContractSHA256', OFFICIAL)
+    expected = {key: binding[key] for key in ('vmID', 'fingerprint', 'owner', 'ownerSetupContractSHA256')}
+    if identity != expected: raise ValueError('identity')
+    owner = pwd.getpwnam(binding['owner'])
+    if not 1000 <= owner.pw_uid < 60000: raise ValueError('owner')
+    retain_report_binding(binding)
+    manifest = dict(binding, configuration={'username': binding['owner']})
+    status(manifest, 'configured')
+
+
+def acknowledge():
+    if not CMDLINE.exists() or 'tryomarchy.managed_setup=1' not in CMDLINE.read_text().split() or PENDING.exists():
+        return
+    if not cleanup_finished(): raise ValueError('cleanup-state')
+    mount_share()
+    manifest_path = SHARE / 'manifest.json'
+    try:
+        manifest_data = read(manifest_path)
+    except FileNotFoundError:
+        binding = local_report_binding()
+    else:
+        binding = report_binding(json.loads(manifest_data))
+    report_completion(binding)
+
+
+def main():
+    global FAILURE
+    if not CMDLINE.exists() or 'tryomarchy.managed_setup=1' not in CMDLINE.read_text().split():
+        os.execv(str(PROGRAM), [str(PROGRAM)])
+    if not PENDING.exists():
+        try:
+            acknowledge()
+            return 0
+        except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
+            print('Saved owner setup completion could not be verified.', file=sys.stderr)
+            return 1
+    manifest = None
+    try:
+        FAILURE = 'unsafe-share'; mount_share()
+        FAILURE = 'invalid-seed'
+        manifest = json.loads(read(SHARE / 'manifest.json'))
+        seed = json.loads(read(SHARE / 'owner-setup.json'))
+        FAILURE = 'contract-mismatch'; contract, adapter = selected_contract(manifest)
+        FAILURE = 'invalid-seed'; keyboard = validate(manifest, seed, contract)
+        validate_report_binding(report_binding(manifest))
+        FAILURE = 'contract-mismatch'; programs = verified_program(contract)
+        FAILURE = 'encrypted-image'
+        output = subprocess.run(['/usr/bin/lsblk', '-nr', '-o', 'TYPE'], check=True, capture_output=True, text=True).stdout
+        if 'crypt' in output.split() or (PENDING.parent / 'wipe-pending').exists():
+            raise ValueError('unsupported-image')
+        FAILURE = 'existing-owner'
+        if IDENTITY.exists():
+            matching_identity(manifest)
+        existing = [p.pw_name for p in pwd.getpwall() if 1000 <= p.pw_uid < 60000 and p.pw_shell not in ('/usr/bin/nologin', '/bin/false', '/usr/sbin/nologin', '/usr/bin/false')]
+        resume = PENDING.parent / 'setup-user'
+        if existing and (existing != [manifest['configuration']['username']] or not resume.exists() or reviewed_bytes(resume, maximum=128).decode().strip() != existing[0]):
+            raise ValueError('existing-account')
+        status(manifest, 'provisioning')
+        FAILURE = 'provisioning-failed'; provision(manifest, seed, keyboard, programs, adapter)
+        matching_identity(manifest)
+        if not cleanup_finished():
+            raise ValueError('cleanup-state')
+        report_completion(report_binding(manifest))
+        return 0
+    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
+        if manifest:
+            try:
+                status(manifest, 'error', FAILURE)
+            except (OSError, KeyError, TypeError):
+                pass
+        print('Saved owner setup could not finish (' + FAILURE + '). Retry after reviewing the failure.', file=sys.stderr)
+        return 1
+
+
+if __name__ == '__main__':
+    if sys.argv[1:] in (['--report'], ['--commit']):
+        try:
+            if sys.argv[1:] == ['--commit']:
+                commit_identity()
+            else:
+                acknowledge()
+        except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
+            sys.exit(1)
+    else:
+        sys.exit(main())
