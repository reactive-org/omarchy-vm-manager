+private final class ClipboardTestFocus: ClipboardFocusProviding {
+    var focused = false
+    var probes: [Bool] = []
+    func isFocused() -> Bool {
+        if !probes.isEmpty { return probes.removeFirst() }
+        return focused
+    }
+}
+
+private final class ClipboardTestPasteboard: HostPasteboardProviding {
+    var changeCount = 0
+    var message: ClipboardMessage?
+    var reads = 0
+    var writes = 0
+    var onRead: (() -> Void)?
+    func read() -> ClipboardMessage? {
+        reads += 1
+        onRead?()
+        return message
+    }
+    func write(_ message: ClipboardMessage) {
+        self.message = message
+        changeCount += 1
+        writes += 1
+    }
+    func copy(_ text: String) {
+        message = ClipboardMessage(format: .text, payload: Data(text.utf8))!
+        changeCount += 1
+    }
+}
+
+private final class ClipboardTestOutput {
+    var messages: [ClipboardMessage] = []
+    func send(_ data: Data) throws {
+        if case .clipboard(let message) = try ClipboardMessage.decode(data) {
+            messages.append(message)
+        }
+    }
+}
