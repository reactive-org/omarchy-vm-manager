+final class FocusedClipboardRouting {
+    private let pasteboard: HostPasteboardProviding
+    private let focus: ClipboardFocusProviding
+    private let send: (Data) throws -> Void
+    private var state = ClipboardSyncState()
+    private var wasFocused = false
+    private var observedChangeCount: Int?
+
+    init(pasteboard: HostPasteboardProviding, focus: ClipboardFocusProviding,
+         send: @escaping (Data) throws -> Void) {
+        self.pasteboard = pasteboard
+        self.focus = focus
+        self.send = send
+    }
+
+    private func stillFocused() -> Bool {
+        guard focus.isFocused() else {
+            wasFocused = false
+            observedChangeCount = nil
+            state = ClipboardSyncState()
+            return false
+        }
+        return true
+    }
+
+    private func reconcileFocus() throws -> (focused: Bool, gained: Bool) {
+        guard stillFocused() else { return (false, false) }
+        let gained = !wasFocused
+        wasFocused = true
+        if gained {
+            state = ClipboardSyncState()
+            try sendHostSelection()
+        }
+        return (wasFocused, gained)
+    }
+
+    private func sendHostSelection() throws {
+        guard stillFocused() else { return }
+        let count = pasteboard.changeCount
+        let message = pasteboard.read()
+        guard stillFocused() else { return }
+        observedChangeCount = count
+        guard let message, state.hostChanged(message) else { return }
+        let data = try message.encode()
+        guard stillFocused() else { return }
+        try send(data)
+    }
+
+    func poll() throws {
+        let transition = try reconcileFocus()
+        guard transition.focused, !transition.gained else { return }
+        guard stillFocused(), pasteboard.changeCount != observedChangeCount else { return }
+        try sendHostSelection()
+    }
+
+    func handle(_ line: ClipboardMessage.GuestLine) throws {
+        let transition = try reconcileFocus()
+        guard transition.focused else { return }
+        switch line {
+        case .sync:
+            guard !transition.gained else { return }
+            state = ClipboardSyncState()
+            try sendHostSelection()
+        case .clipboard(let message):
+            guard !transition.gained, stillFocused(), state.guestChanged(message) else { return }
+            guard stillFocused() else { return }
+            pasteboard.write(message)
+            observedChangeCount = pasteboard.changeCount
+        case .ignored:
+            return
+        }
+    }
+}
