+enum GuestApplicationIdentity {
+    static func identifier(for root: URL) -> String {
+        var pathComponents = root.path.split(separator: "/").map(String.init)
+        var probe = "/" + pathComponents.joined(separator: "/")
+        var suffix: [String] = []
+        var canonical = "/"
+        while true {
+            if let resolved = realpath(probe, nil) {
+                canonical = String(cString: resolved)
+                free(resolved)
+                break
+            }
+            guard !pathComponents.isEmpty else { break }
+            suffix.insert(pathComponents.removeLast(), at: 0)
+            probe = "/" + pathComponents.joined(separator: "/")
+        }
+        var components = canonical.split(separator: "/").map(String.init)
+        for component in suffix {
+            if component == ".." { if !components.isEmpty { components.removeLast() } }
+            else if component != "." { components.append(component) }
+        }
+        let path = "/" + components.joined(separator: "/")
+        let digest = SHA256.hash(data: Data(path.utf8)).map { String(format: "%02x", $0) }.joined()
+        return "dev.tryomarchy.guest." + digest
+    }
