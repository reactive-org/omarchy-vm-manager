diff --git a/macos/Sources/OmarchyVMHelper/ManagedFactoryCache.swift b/macos/Sources/OmarchyVMHelper/ManagedFactoryCache.swift
new file mode 100644
index 0000000..d47aa37
--- /dev/null
+++ b/macos/Sources/OmarchyVMHelper/ManagedFactoryCache.swift
@@ -0,0 +1,67 @@
+import Darwin
+import Foundation
+
+enum ManagedFactoryCache {
+    static let retention: TimeInterval = 7 * 24 * 60 * 60
+
+    static var downloads: URL {
+        FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent("Downloads", isDirectory: true)
+    }
+
+    static func cacheDirectory(downloads: URL = downloads) -> URL {
+        downloads.appendingPathComponent("Omarchy VM Manager/Factory Images", isDirectory: true)
+    }
+
+    static func directory(for root: URL, downloads: URL = downloads) throws -> URL? {
+        let marker = root.appendingPathComponent(".omarchy-vm-manager.json")
+        var info = stat()
+        guard lstat(marker.path, &info) == 0 else {
+            if errno == ENOENT { return nil }
+            throw HelperError.io("Cannot inspect manager factory-cache configuration")
+        }
+        try ManagedSSHLaunch.directory(root)
+        struct Marker: Decodable { let schemaVersion: Int; let id: UUID }
+        let value = try JSONDecoder().decode(Marker.self, from: ManagedSSHLaunch.read(marker))
+        guard value.schemaVersion == 1, value.id.uuidString == root.lastPathComponent else {
+            throw HelperError.io("The factory download cache requires a valid manager-owned UUID root")
+        }
+        return cacheDirectory(downloads: downloads)
+    }
+
+    static func contains(_ directory: URL) -> Bool {
+        directory.standardizedFileURL == cacheDirectory().standardizedFileURL
+    }
+
+    static func prepare(downloads: URL = downloads) throws {
+        var info = stat()
+        if lstat(downloads.path, &info) != 0, errno == ENOENT {
+            guard mkdir(downloads.path, 0o700) == 0 || errno == EEXIST else {
+                throw HelperError.io("Cannot create the Downloads folder for Omarchy images")
+            }
+        }
+        guard lstat(downloads.path, &info) == 0, info.st_mode & S_IFMT == S_IFDIR,
+              info.st_uid == getuid(), info.st_mode & 0o022 == 0 else {
+            throw HelperError.io("The Omarchy image cache needs an owned Downloads folder without symbolic links or writable access for others")
+        }
+        for directory in [downloads.appendingPathComponent("Omarchy VM Manager", isDirectory: true), cacheDirectory(downloads: downloads)] {
+            if mkdir(directory.path, 0o700) != 0, errno != EEXIST {
+                throw HelperError.io("Cannot create the Omarchy image cache in Downloads")
+            }
+            try ManagedSSHLaunch.directory(directory)
+        }
+    }
+
+    static func validateImageFiles(in directory: URL, identity: String) throws {
+        for file in [FactoryImageStore.imageURL(in: directory, identity: identity), FactoryImageStore.partialURL(in: directory, identity: identity)] {
+            var info = stat()
+            guard lstat(file.path, &info) == 0 else {
+                if errno == ENOENT { continue }
+                throw HelperError.io("Cannot inspect the cached Omarchy image")
+            }
+            guard info.st_mode & S_IFMT == S_IFREG, info.st_uid == getuid(), info.st_nlink == 1,
+                  info.st_mode & 0o7777 == 0o600 else {
+                throw HelperError.io("The cached Omarchy image is unsafe; it was preserved")
+            }
+        }
+    }
+}
diff --git a/macos/Sources/OmarchyVMHelper/ManagedSSHLaunch.swift b/macos/Sources/OmarchyVMHelper/ManagedSSHLaunch.swift
new file mode 100644
index 0000000..e798599
--- /dev/null
+++ b/macos/Sources/OmarchyVMHelper/ManagedSSHLaunch.swift
@@ -0,0 +1,55 @@
+import Darwin
+import Foundation
+
+struct ManagedSSHLaunch {
+    struct Manifest: Decodable { let schemaVersion: Int; let vmID: UUID; let sessionToken: UUID; let hostPort: Int }
+    static let environmentKey = "OMARCHY_MANAGED_SSH_ROOT"
+
+    static func environment(root: URL, mappings: [PortForwardMapping], base: [String: String]) throws -> [String: String] {
+        var environment = base
+        environment.removeValue(forKey: environmentKey)
+        let manifest = root.appendingPathComponent(".omarchy-managed-ssh.json")
+        var info = stat()
+        guard lstat(manifest.path, &info) == 0 else {
+            if errno == ENOENT { return environment }
+            throw HelperError.io("Cannot inspect managed SSH configuration")
+        }
+        try directory(root)
+        let value = try JSONDecoder().decode(Manifest.self, from: read(manifest))
+        guard value.schemaVersion == 1, UUID(uuidString: root.lastPathComponent) == value.vmID,
+              (1024...65535).contains(value.hostPort),
+              mappings == [PortForwardMapping(hostPort: value.hostPort, guestPort: 22, protocol: .tcp)] else {
+            throw HelperError.io("Managed SSH requires its registered loopback forwarding and UUID root")
+        }
+        let credentials = root.appendingPathComponent(".manager-ssh")
+        let bootstrap = credentials.appendingPathComponent("bootstrap")
+        try directory(credentials); try directory(bootstrap)
+        for name in ["manifest.json", "host_ed25519", "host_ed25519.pub"] { _ = try read(bootstrap.appendingPathComponent(name)) }
+        struct Bootstrap: Decodable { let schemaVersion: Int; let vmID: UUID; let sessionToken: UUID; let publicKeys: [String] }
+        let provision = try JSONDecoder().decode(Bootstrap.self, from: read(bootstrap.appendingPathComponent("manifest.json")))
+        guard provision.schemaVersion == 1, provision.vmID == value.vmID, provision.sessionToken == value.sessionToken,
+              (1...2).contains(provision.publicKeys.count), provision.publicKeys.allSatisfy({ $0.count <= 16384 && !$0.contains(where: \.isNewline) }) else {
+            throw HelperError.io("Managed SSH provisioning identity does not match this launch")
+        }
+        environment[environmentKey] = bootstrap.path
+        return environment
+    }
+
+    static func directory(_ url: URL) throws {
+        var info = stat()
+        guard lstat(url.path, &info) == 0, info.st_mode & S_IFMT == S_IFDIR, info.st_uid == getuid(), info.st_mode & 0o7777 == 0o700 else {
+            throw HelperError.io("Managed SSH requires private owned directories")
+        }
+    }
+    static func read(_ url: URL) throws -> Data {
+        let fd = open(url.path, O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC)
+        guard fd >= 0 else { throw HelperError.io("Cannot read managed SSH provisioning") }
+        defer { close(fd) }
+        var info = stat()
+        guard fstat(fd, &info) == 0, info.st_mode & S_IFMT == S_IFREG, info.st_uid == getuid(), info.st_nlink == 1,
+              info.st_mode & 0o7777 == 0o600, info.st_size <= 16384 else { throw HelperError.io("Unsafe managed SSH provisioning file") }
+        let data = try FileHandle(fileDescriptor: fd, closeOnDealloc: false).read(upToCount: 16385) ?? Data()
+        guard data.count <= 16384 else { throw HelperError.io("Oversized managed SSH provisioning") }
+        return data
+    }
+}
diff --git a/macos/Sources/OmarchyVMHelper/ManagedSetupLaunch.swift b/macos/Sources/OmarchyVMHelper/ManagedSetupLaunch.swift
new file mode 100644
index 0000000..7763f0c
--- /dev/null
+++ b/macos/Sources/OmarchyVMHelper/ManagedSetupLaunch.swift
@@ -0,0 +1,76 @@
+import CryptoKit
+import Darwin
+import Foundation
+import TryOmarchyKitClient
+
+struct ManagedSetupLaunch {
+    struct Configuration: Codable, Equatable {
+        let username: String; let fullName: String; let email: String
+        let hostnamePrefix: String; let timezone: String; let keyboardID: String
+    }
+    struct Manifest: Codable, Equatable {
+        let schemaVersion: Int; let vmID: UUID; let sessionToken: UUID
+        var ownerSetupContractSHA256: String? = nil
+        let fingerprint: String; let configuration: Configuration; let hostname: String
+    }
+    struct ReportBinding: Encodable {
+        let schemaVersion = 1
+        let vmID: UUID; let sessionToken: UUID; let fingerprint: String
+        let owner: String; let ownerSetupContractSHA256: String
+        init(_ manifest: Manifest) {
+            vmID = manifest.vmID; sessionToken = manifest.sessionToken; fingerprint = manifest.fingerprint
+            owner = manifest.configuration.username
+            ownerSetupContractSHA256 = manifest.ownerSetupContractSHA256 ?? VMOwnerSetupContract.official
+        }
+        func digest() throws -> String {
+            let encoder = JSONEncoder(); encoder.outputFormatting = [.sortedKeys, .withoutEscapingSlashes]
+            return SHA256.hash(data: try encoder.encode(self)).map { String(format: "%02x", $0) }.joined()
+        }
+    }
+    static let reportEnvironmentKey = "OMARCHY_MANAGED_SETUP_REPORT"
+    static let environmentKey = "OMARCHY_MANAGED_SETUP_ROOT"
+    static func environment(root: URL, base: [String: String], contract: String = VMOwnerSetupContract.official) throws -> [String: String] {
+        var environment = base
+        environment.removeValue(forKey: environmentKey)
+        environment.removeValue(forKey: reportEnvironmentKey)
+        let path = root.appendingPathComponent(".omarchy-managed-setup.json")
+        var info = stat()
+        guard lstat(path.path, &info) == 0 else {
+            if errno == ENOENT { return environment }
+            throw HelperError.io("Cannot inspect owner setup")
+        }
+        try ManagedSSHLaunch.directory(root)
+        let value = try JSONDecoder().decode(Manifest.self, from: ManagedSSHLaunch.read(path))
+        guard VMOwnerSetupContract.isSupported(contract), (value.ownerSetupContractSHA256 ?? VMOwnerSetupContract.official) == contract,
+              value.schemaVersion == 1, UUID(uuidString: root.lastPathComponent) == value.vmID,
+              value.fingerprint.range(of: "^[0-9a-f]{64}$", options: .regularExpression) != nil,
+              value.configuration.username != "root", value.configuration.username.range(of: "^[a-z_][a-z0-9_-]{0,31}$", options: .regularExpression) != nil,
+              value.hostname == value.configuration.hostnamePrefix + "-" + value.vmID.uuidString.prefix(8).lowercased() else { throw HelperError.io("Mismatched owner setup identity") }
+        let directory = root.appendingPathComponent(".manager-setup")
+        let bootstrap = directory.appendingPathComponent("bootstrap")
+        try ManagedSSHLaunch.directory(directory); try ManagedSSHLaunch.directory(bootstrap)
+        guard try JSONDecoder().decode(Manifest.self, from: ManagedSSHLaunch.read(bootstrap.appendingPathComponent("manifest.json"))) == value else { throw HelperError.io("Mismatched owner setup seed") }
+        struct Seed: Decodable { let password: String }
+        let seed = try JSONDecoder().decode(Seed.self, from: ManagedSSHLaunch.read(bootstrap.appendingPathComponent("owner-setup.json")))
+        guard (8...1024).contains(seed.password.utf8.count), !seed.password.contains(where: { $0 == "\n" || $0 == "\r" || $0 == "\0" }) else { throw HelperError.io("Invalid owner setup seed") }
+        environment[environmentKey] = bootstrap.path
+        environment[reportEnvironmentKey] = try ReportBinding(value).digest()
+        return environment
+    }
+    static func clearSeed(root: URL, expected: Manifest) throws {
+        let marker = root.appendingPathComponent(".omarchy-managed-setup.json")
+        var info = stat()
+        if lstat(marker.path, &info) != 0, errno == ENOENT { return }
+        try ManagedSSHLaunch.directory(root)
+        let directory = root.appendingPathComponent(".manager-setup")
+        let bootstrap = directory.appendingPathComponent("bootstrap")
+        try ManagedSSHLaunch.directory(directory); try ManagedSSHLaunch.directory(bootstrap)
+        guard try JSONDecoder().decode(Manifest.self, from: ManagedSSHLaunch.read(marker)) == expected else { throw HelperError.io("Owner setup session changed during cleanup") }
+        for path in [bootstrap.appendingPathComponent("owner-setup.json"), bootstrap.appendingPathComponent("manifest.json"), marker] {
+            if lstat(path.path, &info) != 0, errno == ENOENT { continue }
+            _ = try ManagedSSHLaunch.read(path)
+            guard unlink(path.path) == 0 else { throw HelperError.io("Cannot remove owner setup seed") }
+        }
+    }
+
+}
