+        self.manifest["sessionToken"] = str(uuid.uuid4()); self.write_manifest(); m.main()
+        self.assertEqual(hashlib.sha256((m.BASE / "host_ed25519").read_bytes()).hexdigest(), before)
+        self.assertEqual(json.loads((m.RUN / "status.json").read_text())["sessionToken"], self.manifest["sessionToken"])
+
+    def test_vm_identity_changes_are_refused_without_overwriting_keys(self):
