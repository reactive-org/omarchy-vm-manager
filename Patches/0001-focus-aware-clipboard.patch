+private final class ClipboardRunCompletion: @unchecked Sendable {
+    private let lock = NSLock()
+    private var stored: Result<Void, Error>?
+
+    var result: Result<Void, Error>? { lock.withLock { stored } }
+    func finish(_ result: Result<Void, Error>) { lock.withLock { stored = result } }
+}
+
+enum ClipboardMainRunLoop {
+    static func readOnMain<T>(_ read: () -> T) -> T {
+        if Thread.isMainThread { return read() }
+        return DispatchQueue.main.sync(execute: read)
+    }
+
+    static func run(_ operation: @escaping () throws -> Void) throws {
+        guard Thread.isMainThread else {
+            throw HelperError.io("the clipboard bridge must own the main run loop")
+        }
+        _ = NSWorkspace.shared.frontmostApplication
+        let loop = CFRunLoopGetCurrent()
+        var context = CFRunLoopSourceContext(
+            version: 0, info: nil, retain: nil, release: nil, copyDescription: nil,
+            equal: nil, hash: nil, schedule: nil, cancel: nil, perform: { _ in }
+        )
+        guard let keepAlive = CFRunLoopSourceCreate(nil, 0, &context) else {
+            throw HelperError.io("cannot create the clipboard bridge run loop")
+        }
+        CFRunLoopAddSource(loop, keepAlive, .commonModes)
+        defer {
+            CFRunLoopRemoveSource(loop, keepAlive, .commonModes)
+            CFRunLoopSourceInvalidate(keepAlive)
+        }
+        let completion = ClipboardRunCompletion()
+        DispatchQueue(label: "dev.tryomarchy.native.clipboard-bridge-reader").async {
+            let result = Result(catching: operation)
+            CFRunLoopPerformBlock(loop, CFRunLoopMode.commonModes.rawValue) {
+                completion.finish(result)
+                CFRunLoopStop(loop)
+            }
+            CFRunLoopWakeUp(loop)
+        }
+        while completion.result == nil { CFRunLoopRun() }
+        try completion.result!.get()
+    }
+}
