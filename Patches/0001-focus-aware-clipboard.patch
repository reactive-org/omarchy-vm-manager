+@Suite("Display monitor peer identity")
+struct DisplayMonitorPeerTests {
+    @Test("the exact kernel peer is captured and a full monitor backlog never blocks control")
+    func peerAndBusyMonitor() throws {
+        let folder = URL(fileURLWithPath: "/tmp").appendingPathComponent("display-peer-" + UUID().uuidString)
+        try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+        defer { try? FileManager.default.removeItem(at: folder) }
+        let path = folder.appendingPathComponent("qmp").path
+        let listener = socket(AF_UNIX, SOCK_STREAM, 0)
+        try #require(listener >= 0)
+        defer { close(listener) }
+        var address = sockaddr_un()
+        address.sun_family = sa_family_t(AF_UNIX)
+        let bytes = Array(path.utf8)
+        try #require(bytes.count < MemoryLayout.size(ofValue: address.sun_path))
+        withUnsafeMutableBytes(of: &address.sun_path) { $0.copyBytes(from: bytes) }
+        func withAddress<T>(_ action: (UnsafePointer<sockaddr>, socklen_t) -> T) -> T {
+            withUnsafePointer(to: &address) { pointer in
+                pointer.withMemoryRebound(to: sockaddr.self, capacity: 1) {
+                    action($0, socklen_t(MemoryLayout<sockaddr_un>.size))
+                }
+            }
+        }
+        try #require(withAddress { bind(listener, $0, $1) } == 0)
+        try #require(listen(listener, 1) == 0)
+        #expect(try QMPConnection.displayProcess(socketPath: path) == KernelProcessIdentity.capture(processIdentifier: getpid()))
+        let accepted = accept(listener, nil, nil)
+        try #require(accepted >= 0)
+        close(accepted)
+        var clients: [Int32] = []
+        defer { for descriptor in clients { close(descriptor) } }
+        var full = false
+        for _ in 0..<16 {
+            let descriptor = socket(AF_UNIX, SOCK_STREAM, 0)
+            try #require(descriptor >= 0)
+            clients.append(descriptor)
+            try #require(fcntl(descriptor, F_SETFL, O_NONBLOCK) == 0)
+            if withAddress({ connect(descriptor, $0, $1) }) != 0 { full = true; break }
+        }
+        try #require(full)
+        let started = ContinuousClock.now
+        #expect(throws: HelperError.self) { try QMPConnection.displayProcess(socketPath: path) }
+        #expect(ContinuousClock.now - started < .seconds(1))
+    }
+}
