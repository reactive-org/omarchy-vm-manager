+public struct VMFactorySelection: Codable, Equatable, Sendable {
+    public static let capabilityVersion = 1
+    public static let packagePath = "Contents/Resources/guest-packages/try-omarchy-0.1.0-43-aarch64.pkg.tar.zst"
