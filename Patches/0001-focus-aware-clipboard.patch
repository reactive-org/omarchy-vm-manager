+import Darwin
+import Foundation
+
+struct ManagedSetupLaunch {
+    struct Configuration: Codable, Equatable {
+        let username: String; let fullName: String; let email: String
+        let hostnamePrefix: String; let timezone: String; let keyboardID: String
+    }
+    struct Manifest: Codable, Equatable {
+        let schemaVersion: Int; let vmID: UUID; let sessionToken: UUID
+        let fingerprint: String; let configuration: Configuration; let hostname: String
+    }
+    static let environmentKey = "OMARCHY_MANAGED_SETUP_ROOT"
+    static func environment(root: URL, base: [String: String]) throws -> [String: String] {
+        var environment = base
+        environment.removeValue(forKey: environmentKey)
+        let path = root.appendingPathComponent(".omarchy-managed-setup.json")
+        var info = stat()
+        guard lstat(path.path, &info) == 0 else {
+            if errno == ENOENT { return environment }
+            throw HelperError.io("Cannot inspect owner setup")
+        }
+        try ManagedSSHLaunch.directory(root)
+        let value = try JSONDecoder().decode(Manifest.self, from: ManagedSSHLaunch.read(path))
+        guard value.schemaVersion == 1, UUID(uuidString: root.lastPathComponent) == value.vmID,
+              value.fingerprint.range(of: "^[0-9a-f]{64}$", options: .regularExpression) != nil,
+              value.configuration.username != "root", value.configuration.username.range(of: "^[a-z_][a-z0-9_-]{0,31}$", options: .regularExpression) != nil,
+              value.hostname == value.configuration.hostnamePrefix + "-" + value.vmID.uuidString.prefix(8).lowercased() else { throw HelperError.io("Mismatched owner setup identity") }
+        let directory = root.appendingPathComponent(".manager-setup")
+        let bootstrap = directory.appendingPathComponent("bootstrap")
+        try ManagedSSHLaunch.directory(directory); try ManagedSSHLaunch.directory(bootstrap)
+        guard try JSONDecoder().decode(Manifest.self, from: ManagedSSHLaunch.read(bootstrap.appendingPathComponent("manifest.json"))) == value else { throw HelperError.io("Mismatched owner setup seed") }
+        struct Seed: Decodable { let password: String }
+        let seed = try JSONDecoder().decode(Seed.self, from: ManagedSSHLaunch.read(bootstrap.appendingPathComponent("owner-setup.json")))
+        guard (8...1024).contains(seed.password.utf8.count), !seed.password.contains(where: { $0 == "\n" || $0 == "\r" || $0 == "\0" }) else { throw HelperError.io("Invalid owner setup seed") }
+        environment[environmentKey] = bootstrap.path
+        return environment
+    }
+    static func clearSeed(root: URL, expected: Manifest) throws {
+        let marker = root.appendingPathComponent(".omarchy-managed-setup.json")
+        var info = stat()
+        if lstat(marker.path, &info) != 0, errno == ENOENT { return }
+        try ManagedSSHLaunch.directory(root)
+        let directory = root.appendingPathComponent(".manager-setup")
+        let bootstrap = directory.appendingPathComponent("bootstrap")
+        try ManagedSSHLaunch.directory(directory); try ManagedSSHLaunch.directory(bootstrap)
+        guard try JSONDecoder().decode(Manifest.self, from: ManagedSSHLaunch.read(marker)) == expected else { throw HelperError.io("Owner setup session changed during cleanup") }
+        for path in [bootstrap.appendingPathComponent("owner-setup.json"), bootstrap.appendingPathComponent("manifest.json"), marker] {
+            if lstat(path.path, &info) != 0, errno == ENOENT { continue }
+            _ = try ManagedSSHLaunch.read(path)
+            guard unlink(path.path) == 0 else { throw HelperError.io("Cannot remove owner setup seed") }
+        }
+    }
+
+}
